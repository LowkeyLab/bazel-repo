def config(ctx):
    ctx.tasks["format"].args.formatter_target = "//tools/format:format"

    ctx.tasks["lint"].args.bazel_flags = [
        "--config=lint",
        "--remote_cache=grpcs://remote.buildbuddy.io",
    ]
    ctx.tasks["lint"].args.aspects = [
        "//tools/lint:linters.bzl%buf",
        "//tools/lint:linters.bzl%eslint",
        "//tools/lint:linters.bzl%stylelint",
        "//tools/lint:linters.bzl%ruff",
        "//tools/lint:linters.bzl%ty",
        "//tools/lint:linters.bzl%shellcheck",
        "//tools/lint:linters.bzl%pmd",
        "//tools/lint:linters.bzl%checkstyle",
        "//tools/lint:linters.bzl%ktlint",
        "//tools/lint:linters.bzl%clippy",
        "//tools/lint:linters.bzl%keep_sorted",
        "//tools/lint:linters.bzl%vale",
    ]

    # Tooling publication has its own bootstrap and anonymous-access gate.
    ctx.tasks["delivery"].args.query = "kind(\"oci_push rule\", //...) except //tools/book_smartz_browser_worker:push_image"
    ctx.tasks["delivery"].args.bazel_flags = [
        "--compilation_mode=opt",
        # Override the Aspect cache selected automatically on CI.
        "--remote_cache=grpcs://remote.buildbuddy.io",
    ]
    ctx.tasks["delivery"].args.release_bazel_flags = ["--nostamp"]
    ctx.tasks["delivery"].args.max_parallelization = 8

    # Preserve the BuildBuddy cache configured in .bazelrc while reporting to Aspect.
    for name in ["build", "test", "format"]:
        ctx.tasks[name].args.bazel_flags = [
            "--remote_cache=grpcs://remote.buildbuddy.io",
        ]

    # The pinned Java formatter requires the compatible hermetic JDK.
    ctx.tasks["format"].args.bazel_flags += [
        "--java_runtime_version=remotejdk_21",
        "--tool_java_runtime_version=remotejdk_21",
    ]
