{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":approveMajorUpdates", ":automergeAll"],
  "prHourlyLimit": 0,
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Update Topcoat crates and runtime asset paths together",
      "matchManagers": ["cargo", "custom.regex"],
      "matchPackageNames": [
        "topcoat",
        "topcoat-asset",
        "topcoat-core-grammar",
        "topcoat-font-grammar",
        "topcoat-view-grammar",
        "topcoat-runtime"
      ],
      "groupName": "Topcoat"
    },
    {
      "description": "Update Juniper and its Axum integration together",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["juniper", "juniper_axum"],
      "groupName": "Juniper"
    },
    {
      "matchManagers": ["bazel-module"],
      "matchDatasources": ["maven"],
      "postUpgradeTasks": {
        "commands": ["env REPIN=1 bazel run @maven//:pin --config=ci-remote"],
        "fileFilters": ["maven_install.json"],
        "executionMode": "update"
      }
    },
    {
      "matchManagers": ["cargo"],
      "postUpgradeTasks": {
        "commands": [
          "bazel mod deps --lockfile_mode=update --config=ci-remote"
        ],
        "fileFilters": ["MODULE.bazel.lock"],
        "executionMode": "update"
      }
    },
    {
      "matchManagers": ["gomod"],
      "skipArtifactsUpdate": true,
      "postUpgradeTasks": {
        "commands": [
          "bazel run //tools:go_mod_download --config=ci-remote",
          "bazel mod deps --lockfile_mode=update --config=ci-remote"
        ],
        "fileFilters": ["go.mod", "go.sum", "MODULE.bazel.lock"],
        "executionMode": "branch"
      }
    },
    {
      "description": "Preserve pinned dependency versions in Gazelle generation test fixtures",
      "matchManagers": ["cargo"],
      "matchFileNames": ["3rdparty/gazelle_rust/upstream/generation_tests/**"],
      "enabled": false
    },
    {
      "description": "Keep Python interpreter releases and minor versions tested together",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["python", "astral-sh/python-build-standalone"],
      "groupName": "Python interpreter",
      "automerge": true,
      "ignoreTests": false,
      "postUpgradeTasks": {
        "commands": [
          "bazel mod deps --lockfile_mode=update --config=ci-remote",
          "bazel run //tools/python:lock --config=ci-remote",
          "bazel run //:gazelle_python_manifest.update --config=ci-remote",
          "bazel run //:gazelle --config=ci-remote"
        ],
        "fileFilters": [
          "MODULE.bazel.lock",
          "uv.lock",
          "gazelle_python.yaml",
          "python_sample/BUILD.bazel"
        ],
        "executionMode": "branch"
      }
    },
    {
      "description": "Update first-party Python artifacts through Bazel",
      "matchManagers": ["pep621"],
      "matchFileNames": ["pyproject.toml"],
      "skipArtifactsUpdate": true,
      "postUpgradeTasks": {
        "commands": [
          "bazel run //tools/python:lock --config=ci-remote",
          "bazel run //:gazelle_python_manifest.update --config=ci-remote",
          "bazel run //:gazelle --config=ci-remote"
        ],
        "fileFilters": [
          "MODULE.bazel.lock",
          "uv.lock",
          "gazelle_python.yaml",
          "python_sample/BUILD.bazel"
        ],
        "executionMode": "branch"
      }
    },
    {
      "description": "Maintain the supported Python range separately from the selected interpreter",
      "matchManagers": ["pep621"],
      "matchFileNames": ["pyproject.toml"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "description": "Update the stable Rust compiler and formatter together without a release delay",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["rust"],
      "matchDatasources": ["rust-version"],
      "groupName": "Rust toolchain",
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/",
      "minimumReleaseAge": "0 days",
      "schedule": ["at any time"],
      "ignoreUnstable": true,
      "ignoreTests": false,
      "automerge": false,
      "postUpgradeTasks": {
        "commands": [
          "bazel mod deps --lockfile_mode=update --config=ci-remote",
          "bazel run //tools/format:format_Rust_with_rustfmt --config=ci-remote",
          "bazel run //:gazelle --config=ci-remote",
          "bazel run //tools/format:format_Starlark_with_buildifier --config=ci-remote"
        ],
        "fileFilters": [
          "MODULE.bazel",
          "MODULE.bazel.lock",
          "**/*.rs",
          "**/BUILD.bazel"
        ],
        "executionMode": "branch"
      }
    },
    {
      "description": "Automerge stable Rust patch and minor updates after required CI passes",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["rust"],
      "matchDatasources": ["rust-version"],
      "matchUpdateTypes": ["patch", "minor"],
      "dependencyDashboardApproval": false,
      "automerge": true
    },
    {
      "description": "Require approval for Rust major upgrades",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["rust"],
      "matchDatasources": ["rust-version"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^MODULE\\.bazel$/"],
      "matchStrings": [
        "CARGO_MANIFEST_DIR\": \"external/rules_rs\\+\\+crate\\+crates__topcoat-runtime-(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "crate",
      "depNameTemplate": "topcoat-runtime"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^MODULE\\.bazel$/", "/^\\.bazelrc$/"],
      "matchStrings": [
        "# renovate: datasource=python-version depName=python\\s+python_version = \"(?<currentValue>3\\.\\d+)\"",
        "# renovate: datasource=python-version depName=python\\s+common --@rules_python//python/config_settings:python_version=(?<currentValue>3\\.\\d+)"
      ],
      "datasourceTemplate": "python-version",
      "depNameTemplate": "python",
      "versioningTemplate": "semver-coerced",
      "extractVersionTemplate": "^(?<version>3\\.\\d+)(?:\\.\\d+)?$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^MODULE\\.bazel$/"],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=astral-sh/python-build-standalone\\s+releases = \\[\"(?<currentValue>\\d{8})\"\\]"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "astral-sh/python-build-standalone",
      "versioningTemplate": "regex:^(?<patch>\\d{8})$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^MODULE\\.bazel$/"],
      "matchStrings": [
        "toolchains\\.toolchain\\(\\s*name\\s*=\\s*\"default_rust_toolchains\",[^)]*?version\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "rust-version",
      "depNameTemplate": "rust",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^MODULE\\.bazel$/",
        "/^tools/format/BUILD\\.bazel$/"
      ],
      "matchStrings": [
        "rustfmt_linux_x86_64_(?<major>\\d+)_(?<minor>\\d+)_(?<patch>\\d+)"
      ],
      "currentValueTemplate": "{{{major}}}.{{{minor}}}.{{{patch}}}",
      "autoReplaceStringTemplate": "rustfmt_linux_x86_64_{{{replace '[.]' '_' newValue}}}",
      "datasourceTemplate": "rust-version",
      "depNameTemplate": "rust",
      "versioningTemplate": "semver"
    }
  ]
}
