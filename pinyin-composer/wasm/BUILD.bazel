load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_shared_library.bzl", "rust_shared_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "wasm_lib",
    srcs = [
        "src/annotator.rs",
        "src/converter.rs",
        "src/error.rs",
        "src/lib.rs",
        "src/model.rs",
    ],
    crate_name = "pinyin_composer_wasm",
    crate_root = "src/lib.rs",
    deps = [
        "@crates//:console_error_panic_hook",
        "@crates//:pinyin",
        "@crates//:pinyinchch",
        "@crates//:pinyinchch-model-hmm",
        "@crates//:serde",
        "@crates//:serde-wasm-bindgen",
        "@crates//:wasm-bindgen",
    ],
)

rust_shared_library(
    name = "wasm_cdylib",
    srcs = [
        "src/annotator.rs",
        "src/converter.rs",
        "src/error.rs",
        "src/lib.rs",
        "src/model.rs",
    ],
    crate_name = "pinyin_composer_wasm",
    crate_root = "src/lib.rs",
    platform = "@rules_rs//rs/platforms:wasm32-unknown-unknown",
    tags = ["no-lint"],
    deps = [
        "@crates//:console_error_panic_hook",
        "@crates//:pinyin",
        "@crates//:pinyinchch",
        "@crates//:pinyinchch-model-hmm",
        "@crates//:serde",
        "@crates//:serde-wasm-bindgen",
        "@crates//:wasm-bindgen",
    ],
)

genrule(
    name = "pinyin_composer_wasm_bindgen",
    srcs = [":wasm_cdylib"],
    outs = [
        "pinyin_composer_wasm/pinyin_composer_wasm.d.ts",
        "pinyin_composer_wasm/pinyin_composer_wasm.js",
        "pinyin_composer_wasm/pinyin_composer_wasm_bg.wasm",
        "pinyin_composer_wasm/pinyin_composer_wasm_bg.wasm.d.ts",
    ],
    cmd = "$(execpath @crates//:wasm-bindgen-cli__wasm-bindgen) --target web --out-dir $(@D)/pinyin_composer_wasm --out-name pinyin_composer_wasm $(location :wasm_cdylib)",
    tags = ["no-lint"],
    tools = ["@crates//:wasm-bindgen-cli__wasm-bindgen"],
)

rust_test(
    name = "wasm_tests",
    srcs = ["tests/conversion_tests.rs"],
    crate_name = "pinyin_composer_wasm_tests",
    crate_root = "tests/conversion_tests.rs",
    deps = [":wasm_lib"],
)

rust_test(
    name = "wasm_lib_test",
    crate = ":wasm_lib",
)
