load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//:defs.bzl", "ng_application")

# Wrapper script for building Tailwind CSS
sh_binary(
    name = "build_tailwind_bin",
    srcs = ["build_tailwind.sh"],
    data = [
        ":node_modules/autoprefixer",
        ":node_modules/postcss",
        ":node_modules/tailwindcss",
    ],
)

# Collect all source files that Tailwind needs to scan
filegroup(
    name = "tailwind_srcs",
    srcs = glob([
        "app/**/*.html",
        "app/**/*.ts",
    ]) + [
        "main.ts",
    ],
)

# Process Tailwind CSS
genrule(
    name = "styles",
    srcs = [
        "styles.css",
        "tailwind.config.js",
        "postcss.config.js",
        ":tailwind_srcs",
    ],
    outs = ["styles-processed.css"],
    cmd = """
        $(location :build_tailwind_bin) \
            $(location styles.css) \
            $@ \
            $(location tailwind.config.js) \
            $(locations :tailwind_srcs)
    """,
    tools = [":build_tailwind_bin"],
)

# Build the Angular application using ngc compiler
ng_application(
    name = "app",
    html_assets = [":styles"],
)

# Copy all static files to a directory for serving
copy_to_directory(
    name = "dist",
    srcs = [
        "index.html",
        ":app",
    ],
    replace_prefixes = {
        "prod/": "",
    },
)
