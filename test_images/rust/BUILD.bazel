load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

# gazelle:resolve rust futures_util @crates//:futures-util-0.3.34
# gazelle:resolve rust tokio_util @crates//:tokio-util-0.7.19
# gazelle:resolve rust runfiles @rules_rust//rust/runfiles
rust_library(
    name = "test_images",
    testonly = True,
    srcs = ["lib.rs"],
    crate_root = "lib.rs",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:futures-util-0.3.34",
        "@crates//:testcontainers-modules",
        "@crates//:tokio",
        "@crates//:tokio-util-0.7.19",
        "@rules_rust//rust/runfiles",
    ],
)

rust_test(
    name = "test_images_test",
    size = "small",
    crate = ":test_images",
    deps = ["@crates//:axum"],
)

rust_binary(
    name = "postgres_probe",
    testonly = True,
    srcs = ["probe.rs"],
    crate_root = "probe.rs",
    visibility = ["//test_images/go:__pkg__"],
    deps = [
        ":test_images",
        "@crates//:testcontainers-modules",
        "@crates//:tokio",
    ],
)
