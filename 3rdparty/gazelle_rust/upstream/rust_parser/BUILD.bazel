)

rust_binary(
    name = "rust_parser",
    srcs = ["main.rs"],
    crate_root = "main.rs",
    visibility = ["//visibility:public"],
    deps = [
        ":lockfile_crates",
        "//3rdparty/gazelle_rust/upstream/gazelle_rust_parser/src:gazelle_rust_parser",
        "//3rdparty/gazelle_rust/upstream/proto:messages_rust_proto",
        "@crates//:cargo_toml",
        "@crates//:clap",
        "@rules_rs//rs/private/prost",
    ],
