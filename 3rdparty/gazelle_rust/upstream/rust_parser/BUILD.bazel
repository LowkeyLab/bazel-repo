load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")

rust_library(
    name = "lockfile_crates",
    srcs = ["lockfile_crates/lib.rs"],
    crate_root = "lockfile_crates/lib.rs",
    visibility = [":__subpackages__"],
    deps = [
        "//3rdparty/gazelle_rust/upstream/proto:messages_rust_proto",
        "@crates//:cargo-bazel",
        "@crates//:cargo-lock",
