load("@rules_rs//rs:rust_library.bzl", "rust_library")

# gazelle:rust_cargo_lockfile Cargo.lock
# gazelle:rust_crates_prefix //3rdparty/crates:

exports_files(
    srcs = ["Cargo.lock"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "lib",
    srcs = ["lib.rs"],
    crate_root = "lib.rs",
    deps = ["//3rdparty/crates:serde"],
)
