load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "lib1",
    srcs = ["lib1/lib.rs"],
)

rust_library(
    name = "lib2",
    srcs = ["lib2/lib.rs"],
    deps = [
        ":kept_dep",  # keep
        ":lib1",
    ],
)

rust_library(
    name = "lib3",
    srcs = ["lib3/lib.rs"],
    deps = [":lib2"],  # keep
)

# keep
rust_library(
    name = "lib4",
    srcs = ["lib4/lib.rs"],
    deps = [
        ":lib1",
        ":lib2",
    ],
)
