load("@rules_rs//rs:rust_library.bzl", "rust_library")

rust_library(
    name = "aliased_dep",
    srcs = ["src/lib.rs"],
    aliases = {
        "//external_crate": "local_alias",
    },
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = ["//external_crate"],
)
