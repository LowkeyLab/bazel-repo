load("@rules_rs//rs:rust_library.bzl", "rust_library")

rust_library(
    name = "nested_modules",
    srcs = [
        "src/a.rs",
        "src/b.rs",
        "src/b/b1.rs",
        "src/b/b2.rs",
        "src/c/c1.rs",
        "src/c/c2.rs",
        "src/c/c2/c2a.rs",
        "src/c/c3/c3a.rs",
        "src/c/c3/mod.rs",
        "src/c/mod.rs",
        "src/lib.rs",
    ],
    compile_data = ["Cargo.toml"],
    crate_root = "src/lib.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
)
