load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")

# gazelle:rust_feature foo true
# gazelle:rust_feature bar true
# gazelle:rust_feature baz false

rust_library(
    name = "features_lib",
    srcs = [
        "src/foobar.rs",
        "src/lib.rs",
    ],
    compile_data = ["Cargo.toml"],
    crate_features = ["foo"],
    crate_name = "features",
    crate_root = "src/lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "features",
    srcs = ["src/main.rs"],
    compile_data = ["Cargo.toml"],
    crate_features = ["foo"],
    crate_root = "src/main.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [":features_lib"],
)
