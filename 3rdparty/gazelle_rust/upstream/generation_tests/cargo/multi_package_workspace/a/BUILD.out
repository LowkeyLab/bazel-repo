load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")

# gazelle:rust_feature foo false

rust_library(
    name = "a_lib",
    srcs = ["src/lib.rs"],
    compile_data = ["Cargo.toml"],
    crate_name = "a",
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "a",
    srcs = ["src/main.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [":a_lib"],
)
