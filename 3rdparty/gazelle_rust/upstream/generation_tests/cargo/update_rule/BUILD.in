load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")

rust_library(
    name = "update_rule_lib",
    srcs = ["src/lib.rs"],
    crate_name = "update_rule",
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "update_rule",
    srcs = ["src/main.rs"],
    visibility = ["//visibility:private"],
)
