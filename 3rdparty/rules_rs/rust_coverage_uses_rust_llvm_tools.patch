diff --git a/rs/private/rustc_repository.bzl b/rs/private/rustc_repository.bzl
index cbfbe77..2ee6eca 100644
--- a/rs/private/rustc_repository.bzl
+++ b/rs/private/rustc_repository.bzl
@@ -44,6 +44,20 @@ filegroup(
     visibility = ["//visibility:public"],
 )
 
+filegroup(
+    name = "llvm-cov",
+    srcs = ["lib/rustlib/{target_triple}/bin/llvm-cov{binary_ext}"],
+    visibility = ["//visibility:public"],
+)
+
+filegroup(
+    name = "llvm-profdata",
+    srcs = ["lib/rustlib/{target_triple}/bin/llvm-profdata{binary_ext}"],
+    data = glob(["lib/rustlib/{target_triple}/lib/*"], allow_empty = True),
+    visibility = ["//visibility:public"],
+)
+
 _proc_macro_srv_build_file_tmpl = """\
 filegroup(
     name = "rust_analyzer_proc_macro_srv",
@@ -102,9 +116,12 @@ def _rustc_repository_impl(rctx):
     exec_triple = triple(rctx.attr.triple)
     binary_ext = system_to_binary_ext(exec_triple.system)
     download_and_extract(rctx, "rustc", "rustc", exec_triple)
+    download_and_extract(rctx, "llvm-tools", "llvm-tools-preview", exec_triple, sha256 = rctx.attr.llvm_tools_sha256)
 
     # Upstream Linux rustc bundles libLLVM, which dynamically links against libz.so.1.
     _add_linux_zlib(rctx, exec_triple)
+    # Rust llvm-tools binaries load shared libraries from this location.
+    rctx.file("lib/rustlib/{}/lib/.generated".format(exec_triple.str), "")
     _symlink_rust_objcopy_shared_libraries(rctx, exec_triple)
     build_content = _build_file_tmpl.format(
         binary_ext = binary_ext,
@@ -120,4 +137,7 @@ def _rustc_repository_impl(rctx):
 rustc_repository = repository_rule(
     implementation = _rustc_repository_impl,
-    attrs = RUST_REPOSITORY_COMMON_ATTR,
+    attrs = RUST_REPOSITORY_COMMON_ATTR | {
+        "llvm_tools_sha256": attr.string(mandatory = True),
+    },
 )
