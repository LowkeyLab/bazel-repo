+_EXECROOT_RELATIVE_PATH_PREFIXES = ("bazel-out/", "external/")
+
+
+def execroot_relative_path(path):
+    """Resolve Bazel execroot-relative toolchain paths after Cabal chdir."""
+    if not path or os.path.isabs(path):
+        return path
+
+    if not path.startswith(_EXECROOT_RELATIVE_PATH_PREFIXES):
+        return path
+
+    execroot = os.environ.get("RULES_HASKELL_EXEC_ROOT")
+    if not execroot:
+        return path
+
+    candidate = os.path.join(execroot, path)
+    if os.path.exists(candidate):
+        return candidate
+
+    return path
+
+
+def execroot_relative_rpath(rpath):
+    if rpath.startswith(("$ORIGIN", "@loader_path", "@executable_path")):
+        return rpath
+
+    return execroot_relative_path(rpath)
+
+
