load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

rust_binary(
    name = "main",
    srcs = ["main.rs"],
    data = ["data.txt"],
    deps = [
        ":code",
        "@rules_rust//tools/runfiles",
    ],
)

rust_library(
    name = "code",
    srcs = ["code.rs"],
)

rust_test(
    name = "code_test",
    size = "small",
    crate = ":code",
)

rust_library(
    name = "lib",
    srcs = ["lib.rs"],
)
