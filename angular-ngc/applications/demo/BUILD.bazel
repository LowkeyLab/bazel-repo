load("@npm//:@tailwindcss/cli/package_json.bzl", tailwindcss_bin = "bin")
load("//angular-ngc:defs.bzl", "ng_application")

# Collect all source files that Tailwind needs to scan
filegroup(
    name = "tailwind_srcs",
    srcs = glob([
        "app/**/*.html",
        "app/**/*.ts",
    ]) + [
        "main.ts",
    ],
)

# Process Tailwind CSS v4 using the @tailwindcss/cli package
tailwindcss_bin.tailwindcss(
    name = "styles",
    srcs = [
        "styles.css",
        ":tailwind_srcs",
        "//angular-ngc:node_modules/tailwindcss",
    ],
    outs = ["styles-processed.css"],
    args = [
        "--input",
        "$(execpath styles.css)",
        "--output",
        "angular-ngc/applications/demo/styles-processed.css",
    ],
)

# Build the Angular application using ngc compiler
ng_application(
    name = "app",
    html_assets = [":styles"],
)
