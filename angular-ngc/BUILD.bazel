load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//:defs.bzl", "ng_application")

npm_link_all_packages(name = "node_modules")

# Collect all source files that Tailwind needs to scan
filegroup(
    name = "tailwind_srcs",
    srcs = glob([
        "app/**/*.html",
        "app/**/*.ts",
    ]) + [
        "main.ts",
    ],
)

# Process Tailwind CSS using a genrule with the CLI from node_modules
genrule(
    name = "styles",
    srcs = [
        "styles.css",
        ":tailwind_srcs",
        ":node_modules/@tailwindcss/cli",
    ],
    outs = ["styles-processed.css"],
    cmd = """
        $(location :node_modules/@tailwindcss/cli/bin/tailwindcss) \
            --input $(location styles.css) \
            --output $@
    """,
    tools = [":node_modules/@tailwindcss/cli/bin/tailwindcss"],
)

# Build the Angular application using ngc compiler
ng_application(
    name = "app",
    html_assets = [":styles"],
)
