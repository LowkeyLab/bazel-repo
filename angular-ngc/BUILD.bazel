load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//:@tailwindcss/cli/package_json.bzl", tailwindcss_bin = "bin")
load("//:defs.bzl", "ng_application")

npm_link_all_packages(name = "node_modules")

# Collect all source files that Tailwind needs to scan
filegroup(
    name = "tailwind_srcs",
    srcs = glob([
        "app/**/*.html",
        "app/**/*.ts",
    ]) + [
        "main.ts",
    ],
)

# Process Tailwind CSS v4 using the @tailwindcss/cli package
tailwindcss_bin.tailwindcss(
    name = "styles",
    srcs = [
        "styles.css",
        ":tailwind_srcs",
        "//:node_modules/tailwindcss",
    ],
    outs = ["styles-processed.css"],
    args = [
        "--input",
        "$(execpath styles.css)",
        "--output",
        "angular-ngc/styles-processed.css",
    ],
)

# Build the Angular application using ngc compiler
ng_application(
    name = "app",
    html_assets = [":styles"],
)
