load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

# gazelle:java_generate_proto false
# gazelle:python_library_naming_convention $package_name$_py
# gazelle:python_validate_import_statements false
# gazelle:resolve py pinyin_hanzi :lib
# gazelle:resolve py pinyin_hanzi.server :server_lib
# gazelle:resolve py pinyin_hanzi.service :lib

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "hanzi_proto",
    srcs = ["hanzi.proto"],
)

py_library(
    name = "lib",
    srcs = [
        "__init__.py",
        "rpc.py",
        "service.py",
    ],
    deps = [
        ":hanzi_py_pb2",
        "@pypi//grpcio",
        "@pypi//pinyin2hanzi",
        "@pypi//protobuf",
        "@pypi//typing_extensions",
    ],
)

py_library(
    name = "server_lib",
    srcs = ["server.py"],
    deps = [
        "//pinyin_hanzi:lib",
        "@pypi//grpcio",
    ],
)

py_binary(
    name = "server",
    srcs = ["server.py"],
    visibility = ["//:__subpackages__"],
    deps = [":server_lib"],
)

py_test(
    name = "service_test",
    srcs = ["service_test.py"],
    deps = ["//pinyin_hanzi:lib"],
)

py_test(
    name = "service_rpc_test",
    srcs = ["service_rpc_test.py"],
    deps = [
        "//pinyin_hanzi:lib",
        "//pinyin_hanzi:server_lib",
        "@pypi//grpcio",
    ],
)

go_proto_library(
    name = "hanzi_go_proto",
    compilers = [
        "@rules_go//proto:go_proto",
        "@rules_go//proto:go_grpc_v2",
    ],
    importpath = "github.com/lowkeylab/bazel-repo/pinyin_hanzi",
    proto = ":hanzi_proto",
)

go_library(
    name = "pinyin_hanzi",
    embed = [":hanzi_go_proto"],
    importpath = "github.com/lowkeylab/bazel-repo/pinyin_hanzi",
)

py_proto_library(
    name = "hanzi_py_pb2",
    visibility = ["//:__subpackages__"],
    deps = [":hanzi_proto"],
)

py_library(
    name = "pinyin_hanzi_py",
    srcs = [
        "__init__.py",
        "rpc.py",
        "server.py",
        "service.py",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        "//pinyin_hanzi:lib",
        "@pypi//grpcio",
        "@pypi//pinyin2hanzi",
    ],
)
