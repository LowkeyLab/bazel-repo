load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//angular/bzl:ng.bzl", "ng_application", "ng_test")

copy_to_bin(
    name = "srcs",
    srcs = glob(
        ["src/**/*"],
    ),
)

ng_application(
    name = "predix",
    tailwindcss = True,
    zonejs = False,
    deps = [
        "//angular:node_modules/daisyui",
    ],
)

ng_test(
    name = "test",
    srcs = [":srcs"],
    karma = True,
    tailwindcss = True,
    zonejs = False,
    deps = [
        "//angular:node_modules/daisyui",
    ],
)
