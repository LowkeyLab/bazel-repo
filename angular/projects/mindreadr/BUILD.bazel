load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@rules_angular//src/architect:ng_application.bzl", "ng_application")
load("@rules_angular//src/architect:ng_test.bzl", "ng_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//:pkg.bzl", "pkg_tar")

copy_to_bin(
    name = "srcs",
    srcs = glob(
        ["src/**/*"],
    ),
)

js_library(
    name = "canvas_confetti",
    deps = [
        "//angular:node_modules/@types/canvas-confetti",
        "//angular:node_modules/canvas-confetti",
    ],
)

TAILWIND_DEPS = [
    "//angular:node_modules/@tailwindcss/postcss",
    "//angular:node_modules/daisyui",
    "//angular:node_modules/postcss",
    "//angular:node_modules/tailwindcss",
    "//angular:postcssrc",
]

ng_application(
    name = "mindreadr",
    ng_config = "//angular:ng-config",
    node_modules = "//angular:node_modules",
    deps = TAILWIND_DEPS + [
        ":canvas_confetti",
    ],
)

ng_test(
    name = "test",
    size = "small",
    srcs = [":srcs"],
    ng_config = "//angular:ng-config",
    node_modules = "//angular:node_modules",
    tags = ["no-remote-exec"],
    deps = TAILWIND_DEPS + [
        ":canvas_confetti",
    ],
)

pkg_tar(
    name = "caddyfile_layer",
    srcs = ["Caddyfile"],
    package_dir = "/etc/caddy",
)

pkg_tar(
    name = "frontend_layer",
    srcs = [":mindreadr"],
    package_dir = "/app",
    strip_prefix = "dist",
)

oci_image(
    name = "image",
    base = "@alpine_caddy",
    entrypoint = [
        "caddy",
        "run",
        "--config",
        "/etc/caddy/Caddyfile",
    ],
    tars = [
        ":caddyfile_layer",
        ":frontend_layer",
    ],
)

oci_load(
    name = "load_image",
    image = ":image",
    repo_tags = ["lowkeylab/mindreadr_frontend:latest"],
)

oci_push(
    name = "push_image",
    image = ":image",
    remote_tags = ["latest"],
    repository = "ghcr.io/lowkeylab/mindreadr_frontend",
)
