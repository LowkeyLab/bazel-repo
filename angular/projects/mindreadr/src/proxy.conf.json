{
  "/api/games": {
    "target": "http://localhost:8080",
    "secure": false,
    "changeOrigin": true,
    "logLevel": "debug",
    "pathRewrite": { "^/api/games": "/games" }
  },
  "/api/games/*/live": {
    "target": "ws://localhost:8080",
    "secure": false,
    "changeOrigin": true,
    "ws": true,
    "pathRewrite": { "^/api/games": "/games" }
  }
}
