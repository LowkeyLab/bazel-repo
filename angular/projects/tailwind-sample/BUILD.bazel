load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary")
load("@rules_angular//src/architect:ng_application.bzl", "ng_application")
load("@rules_angular//src/architect:ng_test.bzl", "ng_test")

# aspect:generation_mode update_only
package(default_visibility = ["//visibility:public"])

# Source CSS file with @import, @plugin, and @source directives (TailwindCSS v4 syntax)
# This is the source - developers edit this file
exports_files(["src/styles.source.css"])

# TailwindCSS CSS generator using js_binary
# This uses a minimal wrapper to invoke the bin from @tailwindcss/cli package.json
# Run with: bazel run //angular/projects/tailwind-sample:generate-css
js_binary(
    name = "generate-css",
    data = [
        "src/styles.source.css",
        "//angular:node_modules/@tailwindcss/cli",
        "//angular:node_modules/@tailwindcss/postcss",
        "//angular:node_modules/daisyui",
        "//angular:node_modules/tailwindcss",
    ] + glob([
        "src/**/*.html",
        "src/**/*.ts",
    ]),
    # Minimal wrapper that resolves and executes the bin from package.json
    entry_point = "tailwindcss-bin.js",
)

# Build-time TailwindCSS generator binary
js_binary(
    name = "tailwindcss-generator-bin",
    data = [
        "//angular:node_modules/@tailwindcss/cli",
        "//angular:node_modules/@tailwindcss/postcss",
        "//angular:node_modules/daisyui",
        "//angular:node_modules/tailwindcss",
    ],
    entry_point = "tailwindcss-generate.js",
)

# Generate styles.css from styles.source.css at build time
js_run_binary(
    name = "generate-styles-css",
    srcs = [
        "src/styles.source.css",
    ] + glob([
        "src/**/*.html",
        "src/**/*.ts",
    ]),
    outs = ["_generated_styles.css"],
    args = [
        "$(location src/styles.source.css)",
        "$(location _generated_styles.css)",
    ],
    tool = ":tailwindcss-generator-bin",
)

# Write the generated styles.css to the source tree
# Run with: bazel run //angular/projects/tailwind-sample:write-styles-css
# This will update src/styles.css if it differs from the generated output
write_source_files(
    name = "write-styles-css",
    files = {
        "src/styles.css": ":_generated_styles.css",
    },
)

copy_to_bin(
    name = "srcs",
    srcs = glob(
        ["src/**/*"],
        exclude = [
            "dist/",
            "src/styles.source.css",  # Don't include source in build
        ],
    ),
)

ng_application(
    name = "tailwind-sample",
    ng_config = "//angular:ng-config",
    node_modules = "//angular:node_modules",
)

ng_test(
    name = "test",
    size = "small",
    srcs = [":srcs"],
    ng_config = "//angular:ng-config",
    node_modules = "//angular:node_modules",
    tags = ["no-remote-exec"],
)
