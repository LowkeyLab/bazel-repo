load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary")
load("@npm//angular:@tailwindcss/cli/package_json.bzl", tailwindcss_bin = "bin")
load("@rules_angular//src/architect:ng_application.bzl", "ng_application")
load("@rules_angular//src/architect:ng_test.bzl", "ng_test")

# aspect:generation_mode update_only
package(default_visibility = ["//visibility:public"])

# TailwindCSS CSS generator using js_binary
# This uses a minimal wrapper to invoke the bin from @tailwindcss/cli package.json
# Run with: bazel run //angular/projects/tailwind-sample:generate-css
js_binary(
    name = "generate-css",
    data = [
        "src/styles.source.css",
        "//angular:node_modules/@tailwindcss/cli",
        "//angular:node_modules/@tailwindcss/postcss",
        "//angular:node_modules/daisyui",
        "//angular:node_modules/tailwindcss",
    ] + glob([
        "src/**/*.html",
        "src/**/*.ts",
    ]),
    # Minimal wrapper that resolves and executes the bin from package.json
    entry_point = "tailwindcss-bin.js",
)

tailwindcss_bin.tailwindcss_binary(
    name = "tailwindcss",
    data = [
        "//angular:node_modules/@tailwindcss/cli",
        "//angular:node_modules/@tailwindcss/postcss",
        "//angular:node_modules/daisyui",
        "//angular:node_modules/tailwindcss",
    ] + glob([
        "src/**/*.html",
        "src/**/*.ts",
    ]),
)

js_run_binary(
    name = "tailwindcss_runner",
    srcs = [
        "src/styles.source.css",
    ],
    outs = ["src/styles.css"],
    args = [
        "--input",
        "$(location src/styles.source.css)",
        "--output",
        "angular/projects/tailwind-sample/src/styles.css",
    ],
    tool = ":tailwindcss",
)

write_source_files(
    name = "write_styles_css",
    files = {
        "src/styles.css": ":tailwindcss_runner",
    },
)

copy_to_bin(
    name = "srcs",
    srcs = glob(
        ["src/**/*"],
        exclude = [
            "dist/",
            "src/styles.source.css",  # Don't include source in build
        ],
    ),
)

ng_application(
    name = "tailwind-sample",
    ng_config = "//angular:ng-config",
    node_modules = "//angular:node_modules",
)

ng_test(
    name = "test",
    size = "small",
    srcs = [":srcs"],
    ng_config = "//angular:ng-config",
    node_modules = "//angular:node_modules",
    tags = ["no-remote-exec"],
)
