load("//tools/coverage:rust.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "core",
    srcs = [
        "expression.rs",
        "graph.rs",
        "lib.rs",
        "node.rs",
