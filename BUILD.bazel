"""Targets in the repository root"""

load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_py//uv/unstable:defs.bzl", "gazelle_python_manifest")
load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@gazelle//:def.bzl", "DEFAULT_LANGUAGES", "gazelle", "gazelle_binary")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_clojure//rules:tools_deps.bzl", "clojure_gen_srcs")
load("@rules_kotlin//kotlin:core.bzl", "define_kt_toolchain")

npm_link_all_packages(name = "node_modules")

clojure_gen_srcs(name = "clojure_gen_build_files")

gazelle_python_manifest(
    name = "gazelle_python_manifest",
    hub = "pypi",
    venvs = ["default"],
)

diff_test(
    name = "gazelle_python_manifest_test",
    size = "small",
    file1 = "gazelle_python.yaml",
    file2 = ":gazelle_python_manifest",
)

exports_files(
    [
        "Cargo.toml",
        "MODULE.bazel",
        "deps.edn",
        "pyproject.toml",
        "uv.lock",
    ],
    visibility = ["//visibility:public"],
)

exports_files(
    [
        ".clang-tidy",
        ".ruff.toml",
        ".shellcheckrc",
        "buf.yaml",
        "checkstyle.xml",
        "gazelle_python.yaml",
        "pmd.xml",
        ".editorconfig",
        ".ktlint-baseline.xml",
        ".clippy.toml",
    ],
    visibility = [
        "//tools/format:__pkg__",
        "//tools/lint:__pkg__",
    ],
)

js_library(
    name = "eslintrc",
    srcs = ["eslint.config.mjs"],
    # prevent conflicting actions when linting
    tags = ["no-lint"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":node_modules/@eslint/js",
        ":node_modules/typescript-eslint",
    ],
)

js_library(
    name = "prettierrc",
    srcs = ["prettier.config.mjs"],
    # prevent conflicting actions when linting
    tags = ["no-lint"],
    visibility = ["//tools/format:__pkg__"],
    deps = [],
)

js_library(
    name = "stylelintrc",
    srcs = ["stylelint.config.mjs"],
    # prevent conflicting actions when linting
    tags = ["no-lint"],
    visibility = ["//tools/lint:__pkg__"],
    deps = [
        ":node_modules/stylelint",
    ],
)

# Gazelle configuration
# gazelle:map_kind py_library py_library //tools/python:defs.bzl
# gazelle:map_kind py_binary py_binary //tools/python:defs.bzl
# gazelle:map_kind py_test py_test //tools/python:defs.bzl
# gazelle:python_generate_pyi_deps false
# gazelle:python_generate_pyi_srcs false
# gazelle:python_generation_mode package
# gazelle:exclude githooks/*
# gazelle:exclude tools/*
# gazelle:exclude angular/*
# gazelle:exclude ktor_tutorial/*
# gazelle:exclude mindreadr/*
# gazelle:rust_cargo_lockfile Cargo.lock
# gazelle:rust_crates_prefix @crates//:
# gazelle:ts_enabled false
# gazelle:ts_npm_link_pattern //:node_modules/{pkg}
gazelle(
    name = "gazelle",
    gazelle = ":gazelle_bin",
)

gazelle_binary(
    name = "gazelle_bin",
    languages = DEFAULT_LANGUAGES + [
        "@contrib_rules_jvm//java/gazelle",
        "@bazel_skylib_gazelle_plugin//bzl",
        "//3rdparty/gazelle_rust/upstream/rust_language",
        "@gazelle_ts//ts",
        "@rules_python_gazelle_plugin//python",
    ],
)

### Kotlin toolchain configuration
define_kt_toolchain(
    name = "kotlin_toolchain",
    jvm_target = "25",
)

### Rust project generation
alias(
    name = "gen_rust_project",
    actual = "@rules_rs//tools/rust_analyzer:gen_rust_project",
)

# Prose lint covers Markdown in this package, including nested non-package directories.
filegroup(
    name = "markdown",
    srcs = glob(
        ["**/*.md"],
        exclude = [
            "3rdparty/**",
            "bazel-*/**",
            ".*/**",
            "**/node_modules/**",
            "**/target/**",
        ],
    ) + [
        ".claude/agents/relay-spec-checker.md",
        ".claude/skills/agent-browser-frontend-testing/SKILL.md",
        ".claude/skills/bazel-workflow/SKILL.md",
    ],
    tags = ["markdown"],
    visibility = ["//tools/lint:__pkg__"],
)

copy_to_bin(
    name = ".vale_ini",
    srcs = [".vale.ini"],
    visibility = ["//tools/lint:__pkg__"],
)
