# A top-level build file most often contains tooling and convenience aliases.
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@bazel_gazelle//:def.bzl", "gazelle", "gazelle_binary")
load("@npm//:defs.bzl", "npm_link_all_packages")

# JS BUILD generation is opt-in per project
# aspect:js disabled

# Global config shared across monorepo.
# aspect:js_npm_package_target_name pkg
# aspect:js_package_rule_kind js_library
# aspect:js_project_naming_convention tsc

# gazelle:exclude py_mypy
package(default_visibility = ["//:__subpackages__"])

npm_link_all_packages(name = "node_modules")

alias(
    name = "format",
    actual = "//tools/format",
)

exports_files(
    [
        ".clang-tidy",
        ".ruff.toml",
        ".shellcheckrc",
        "buf.yaml",
        "checkstyle.xml",
        "gazelle_python.yaml",
        "pmd.xml",
        "pyproject.toml",
    ],
)

js_library(
    name = "eslintrc",
    srcs = ["eslint.config.mjs"],
    deps = [
        ":node_modules/@eslint/js",
        ":node_modules/typescript-eslint",
    ],
)

###### Gazelle ######
# https://github.com/bazel-contrib/bazel-gazelle
# https://github.com/aspect-build/aspect-gazelle

gazelle(
    name = "gazelle",
    gazelle = ":gazelle_binary",
)

gazelle_binary(
    name = "gazelle_binary",
    languages = [
        "@bazel_gazelle//language/go",  # Built-in rule from gazelle for Golang.
        "@bazel_gazelle//language/proto",  # Built-in rule from gazelle for Protos.
        # Any languages that depend on Gazelle's proto plugin must come after it.
        "@rules_python_gazelle_plugin//python",
        # Temporarily disabled due to JDK 25 / protobuf 33.0 compatibility issues
        # "@contrib_rules_jvm//java/gazelle",
    ],
)
