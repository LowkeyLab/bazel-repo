load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "simulator",
    srcs = [
        "aura.rs",
        "death.rs",
        "enchantment.rs",
        "lib.rs",
        "native_effect.rs",
        "resolver.rs",
        "rng.rs",
        "simulation.rs",
        "simulation_action.rs",
        "simulation_action_validation.rs",
        "simulation_card_runtime.rs",
        "simulation_checkpoint.rs",
        "simulation_effect_executor.rs",
        "simulation_event_resolver.rs",
        "simulation_health.rs",
        "simulation_player.rs",
        "simulation_resolution_validation.rs",
        "simulation_snapshot.rs",
        "simulation_test_support.rs",
        "simulation_tests_actions.rs",
        "simulation_tests_api.rs",
        "simulation_tests_auras.rs",
        "simulation_tests_effects.rs",
        "simulation_tests_events.rs",
        "simulation_tests_health.rs",
        "simulation_tests_hero.rs",
        "simulation_tests_movement.rs",
        "simulation_tests_temporal.rs",
        "trigger.rs",
        "weapon.rs",
        "zone.rs",
    ],
    compile_data = ["//:Cargo.toml"],
    crate_name = "hearthstone_simulator",
    crate_root = "lib.rs",
    rustc_env = {"CARGO_MANIFEST_DIR": "."},
    deps = [
        "//hearthstone_simulator/core",
        "@crates//:bevy",
    ],
)

rust_test(
    name = "simulator_test",
    size = "small",
    crate = ":simulator",
    deps = [
        "//hearthstone_simulator/core",
        "@crates//:googletest",
    ],
)
