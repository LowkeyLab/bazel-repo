load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "core",
    srcs = [
        "action.rs",
        "aura.rs",
        "card_definition.rs",
        "checkpoint.rs",
        "death.rs",
        "effect.rs",
        "enchantment.rs",
        "entity.rs",
        "error.rs",
        "event.rs",
        "game.rs",
        "ids.rs",
        "lib.rs",
        "model.rs",
        "native_effect.rs",
        "resolver.rs",
        "rng.rs",
        "ruleset.rs",
        "snapshot.rs",
        "trace.rs",
        "trigger.rs",
        "zone.rs",
    ],
    compile_data = ["//:Cargo.toml"],
    crate_name = "hearthstone_simulator_core",
    rustc_env = {"CARGO_MANIFEST_DIR": "."},
    deps = [
        "@crates//:bevy",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "core_test",
    size = "small",
    crate = ":core",
    deps = ["@crates//:googletest"],
)
