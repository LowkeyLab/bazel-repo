{
  "name": "bazel-repo",
  "version": "1.0.0",
  "private": true,
  "description": "Bazel monorepo",
  "// dependencies": "in the root package, only dependencies for monorepo-wide tooling should appear",
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@eslint/js": "catalog:",
    "@tsconfig/strictest": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "stylelint": "catalog:",
    "tsconfig-to-swcconfig": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ],
    "packageExtensions": {
      "@analogjs/vite-plugin-angular": {
        "dependencies": {
          "@angular-devkit/architect": "*",
          "@angular/compiler": "*",
          "@angular/compiler-cli": "*",
          "tinyglobby": "*",
          "typescript": "*",
          "vite": "*"
        }
      },
      "apollo-angular": {
        "dependencies": {
          "@angular/common": "*"
        }
      }
    },
    "patchedDependencies": {
      "vite@7.3.1": "patches/vite@7.3.1.patch"
    }
  }
}
