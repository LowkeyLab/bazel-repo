load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//tools/test_images:defs.bzl", "image_data", "image_env")
load("//tools/topcoat:defs.bzl", "topcoat_assets", "topcoat_package", "topcoat_rust_binary", "topcoat_rust_library", "topcoat_tailwind")

package(default_visibility = ["//visibility:public"])

topcoat_rust_library(
    name = "views",
    package_name = "compatibility-views",
    srcs = ["views.rs"],
    asset_inputs = [
        "library.txt",
        ":fixture_font",
    ],
    crate_name = "compatibility_views",
    crate_root = "views.rs",
    iconify_json = ":fixture_icons",
    macro_dependencies = {"topcoat": "topcoat"},
    deps = ["@crates//:topcoat"],
)

topcoat_rust_binary(
    name = "app",
    package_name = "topcoat-compatibility",
    srcs = ["app.rs"],
    asset_inputs = [":styles"],
    crate_name = "topcoat_compatibility",
    crate_root = "app.rs",
    macro_dependencies = {"topcoat": "topcoat"},
    topcoat_deps = [":views_topcoat_inputs"],
    deps = [
        ":views",
        "//book_smartz/domain:lib",
        "//book_smartz/storage:lib",
        "@crates//:anyhow",
        "@crates//:chrono",
        "@crates//:sqlx",
        "@crates//:tokio",
        "@crates//:topcoat",
        "@crates//:uuid",
    ],
)

genrule(
    name = "fixture_font",
    srcs = ["//tools:node_modules/@fontsource/roboto"],
    outs = ["fixture_assets/fixture.woff2"],
    cmd = "for p in $(execpaths //tools:node_modules/@fontsource/roboto); do case $$p in */tools/node_modules/@fontsource/roboto) cp $$p/files/roboto-latin-400-normal.woff2 $@ ;; esac; done",
)

genrule(
    name = "fixture_icons",
    srcs = ["//tools:node_modules/@iconify-json/feather"],
    outs = ["fixture_assets/topcoat-icon-iconify/feather.json"],
    cmd = "for p in $(execpaths //tools:node_modules/@iconify-json/feather); do case $$p in */tools/node_modules/@iconify-json/feather) cp $$p/icons.json $@ ;; esac; done",
)

topcoat_tailwind(
    name = "styles",
    srcs = [
        "app.rs",
        "views.rs",
    ],
    cli = "//tools:tailwindcss",
    css = "input.css",
    deps = ["//:node_modules/tailwindcss"],
)

topcoat_assets(
    name = "all_inputs",
    srcs = [
        ":app_topcoat_inputs",
        "@crates//:topcoat_runtime_assets",
    ],
)

topcoat_package(
    name = "package",
    binary = ":app",
    inputs = [":all_inputs"],
)

rust_binary(
    name = "run",
    srcs = ["run.rs"],
    crate_root = "run.rs",
    data = [":package"],
    env = {"PACKAGE_ARCHIVE": "$(rlocationpath :package)"},
    deps = [
        "@crates//:anyhow",
        "@crates//:tar",
        "@crates//:tempfile",
        "@rules_rust//tools/runfiles",
    ],
)

rust_test(
    name = "compatibility_test",
    size = "medium",
    srcs = ["compatibility_test.rs"],
    crate_root = "compatibility_test.rs",
    data = [
        ":package",
        "//tools/topcoat:format",
    ] + image_data("postgres_18"),
    env = image_env("postgres_18") | {
        "PACKAGE_ARCHIVE": "$(rlocationpath :package)",
        "FORMAT_TOOL": "$(rlocationpath //tools/topcoat:format)",
    },
    exec_properties = {
        "test.workload-isolation-type": "firecracker",
        "test.init-dockerd": "true",
    },
    tags = [
        "requires-docker",
        "requires-network",
    ],
    deps = [
        "//test_images/rust:test_images",
        "@crates//:googletest",
        "@crates//:regex",
        "@crates//:reqwest",
        "@crates//:sqlx",
        "@crates//:tar",
        "@crates//:tempfile",
        "@crates//:testcontainers-modules",
        "@crates//:tokio",
        "@crates//:uuid",
        "@rules_rust//tools/runfiles",
    ],
)

filegroup(
    name = "markdown",
    srcs = glob(["**/*.md"]),
    tags = ["markdown"],
    visibility = ["//tools/lint:__pkg__"],
)
