"""Throwaway Topcoat build-interface experiment."""

load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load(":format.bzl", "format_adapter")

package(default_visibility = ["//visibility:public"])

exports_files(["defs.bzl"])

rust_binary(
    name = "bundle",
    srcs = ["bundle.rs"],
    crate_root = "bundle.rs",
    deps = [
        "@crates//:anyhow",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:topcoat-asset",
    ],
)

rust_binary(
    name = "format_impl",
    srcs = ["format.rs"],
    crate_root = "format.rs",
    deps = [
        "@crates//:anyhow",
        "@crates//:topcoat-core-grammar",
        "@crates//:topcoat-font-grammar",
        "@crates//:topcoat-view-grammar",
    ],
)

format_adapter(name = "format")
