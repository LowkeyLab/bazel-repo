load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_binary(
    name = "ci",
    srcs = ["main.rs"],
    crate_root = "main.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:anyhow",
        "@crates//:clap",
        "@crates//:regex",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:uuid",
    ],
)

rust_binary(
    name = "fake_bazel",
    testonly = True,
    srcs = ["fake_bazel.rs"],
    crate_root = "fake_bazel.rs",
    edition = "2024",
    deps = ["@crates//:serde_json"],
)

rust_test(
    name = "ci_test",
    size = "small",
    srcs = ["ci_test.rs"],
    crate_root = "ci_test.rs",
    data = [
        ":ci",
        ":fake_bazel",
    ],
    edition = "2024",
    rustc_env = {
        "CI_RUNNER": "$(rootpath :ci)",
        "FAKE_BAZEL": "$(rootpath :fake_bazel)",
    },
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:googletest",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)
