load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":providers",
        ":runtime",
    ],
)

py_binary(
    name = "generate",
    srcs = ["generate.py"],
    main = "generate.py",
    visibility = ["//visibility:public"],
)

py_test(
    name = "generation_test",
    size = "small",
    srcs = ["generation_test.py"],
    data = [
        "//tools/cargo_publish/fixtures:binary_publish_files",
        "//tools/cargo_publish/fixtures:combined_publish_files",
        "//tools/cargo_publish/fixtures:combined_repeat_files",
        "//tools/cargo_publish/fixtures:publish_files",
        "//tools/cargo_publish/fixtures:repeat_files",
    ],
)

py_test(
    name = "command_test",
    size = "small",
    srcs = ["command_test.py"],
    data = [":generate"],
    env = {"GENERATOR": "$(rootpath :generate)"},
)

bzl_library(
    name = "fixture_tests",
    srcs = ["fixture_tests.bzl"],
    visibility = ["//tools/cargo_publish/fixtures:__pkg__"],
    deps = [":defs"],
)

filegroup(
    name = "markdown",
    srcs = ["README.md"],
    tags = ["markdown"],
)

py_binary(
    name = "verify",
    srcs = ["verify.py"],
    main = "verify.py",
    visibility = ["//visibility:public"],
    deps = [":report"],
)

py_test(
    name = "runtime_test",
    size = "small",
    srcs = ["runtime_test.py"],
    data = [":verify"],
    env = {"VERIFIER": "$(rootpath :verify)"},
    deps = [":report"],
)

bzl_library(
    name = "providers",
    srcs = ["providers.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "runtime",
    srcs = ["runtime.bzl"],
    visibility = ["//visibility:public"],
    deps = [":providers"],
)

py_library(
    name = "report",
    srcs = ["report.py"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "matrix_test",
    size = "small",
    srcs = ["matrix_test.py"],
    data = [":verify"],
    env = {"VERIFIER": "$(rootpath :verify)"},
    deps = [":report"],
)

py_binary(
    name = "ci",
    srcs = ["ci.py"],
    main = "ci.py",
)

py_test(
    name = "ci_test",
    size = "small",
    srcs = ["ci_test.py"],
    data = [":ci"],
    env = {"CI_RUNNER": "$(rootpath :ci)"},
)
