load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":providers",
        ":runtime",
    ],
)

alias(
    name = "generate",
    actual = "//tools/cargo_publish/generate:generate",
    visibility = ["//visibility:public"],
)

test_suite(
    name = "generation_test",
    tests = ["//tools/cargo_publish/generate:generation_test"],
)

test_suite(
    name = "command_test",
    tests = ["//tools/cargo_publish/generate:command_test"],
)

bzl_library(
    name = "fixture_tests",
    srcs = ["fixture_tests.bzl"],
    visibility = ["//tools/cargo_publish/fixtures:__pkg__"],
    deps = [":defs"],
)

filegroup(
    name = "markdown",
    srcs = ["README.md"],
    tags = ["markdown"],
)

alias(
    name = "verify",
    actual = "//tools/cargo_publish/verify:verify",
    visibility = ["//visibility:public"],
)

test_suite(
    name = "runtime_test",
    tests = [
        "//tools/cargo_publish/core:core_test",
        "//tools/cargo_publish/verify:command_test",
    ],
)

bzl_library(
    name = "providers",
    srcs = ["providers.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "runtime",
    srcs = ["runtime.bzl"],
    visibility = ["//visibility:public"],
    deps = [":providers"],
)

alias(
    name = "report",
    actual = "//tools/cargo_publish/core:core",
    visibility = ["//visibility:public"],
)

test_suite(
    name = "matrix_test",
    tests = ["//tools/cargo_publish/verify:command_test"],
)

alias(
    name = "ci",
    actual = "//tools/cargo_publish/ci:ci",
)

test_suite(
    name = "ci_test",
    tests = ["//tools/cargo_publish/ci:ci_test"],
)
