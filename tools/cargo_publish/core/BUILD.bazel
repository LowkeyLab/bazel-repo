load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "core",
    srcs = [
        "analysis.rs",
        "archive.rs",
        "certification_tests.rs",
        "environment.rs",
        "error.rs",
        "hash.rs",
        "json.rs",
        "lib.rs",
        "model.rs",
        "path.rs",
        "report.rs",
        "tests.rs",
    ],
    compile_data = glob(["testdata/*"]),
    crate_name = "cargo_publish_core",
    crate_root = "lib.rs",
    deps = [
        "@crates//:flate2-1.1.10",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tar",
        "@crates//:tempfile",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "core_test",
    size = "small",
    crate = ":core",
    deps = [
        "@crates//:googletest",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)
