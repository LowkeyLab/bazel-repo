load(":defs.bzl", "test_image")

package(default_visibility = ["//visibility:public"])

# gazelle:ignore

test_image(
    name = "postgres_18",
    image = "@test_postgres_18",
    repository = "127.0.0.1/bazel-test/postgres:",
)

# Use a dotted loopback address: Go Testcontainers does not recognize bare
# localhost as a registry, and would also prepend the Ryuk prefix to PostgreSQL.
# Go Testcontainers prepends the configured Hub prefix to this exact Ryuk name.
test_image(
    name = "ryuk",
    image = "@test_ryuk",
    repository = "127.0.0.1/bazel-test/",
    tag_suffix = "/testcontainers/ryuk:0.14.0",
)
