+# Linux resolves the executable through /proc/self/exe without host tools.
+# Preserve explicit resolution on other hosts.
+if [[ "${OSTYPE}" != linux* ]]; then
+  while [ -L "${GO_BINARY}" ]; do
+    link="$(readlink "${GO_BINARY}")"
+    case "${link}" in
+      /*) GO_BINARY="${link}" ;;
+      *) GO_BINARY="$(dirname "${GO_BINARY}")/${link}" ;;
+    esac
+  done
+fi
 
 # We do not use -a here as the cache drastically reduces the time spent
