load("//tools/coverage:rust.bzl", "rust_library", "rust_test")

rust_library(
    name = "software_factory",
    srcs = [
        "controller.rs",
        "github.rs",
        "history.rs",
        "lib.rs",
        "model.rs",
        "native_worker.rs",  # keep
        "policy.rs",
        "store.rs",
        "worker.rs",  # keep
        "worker_io.rs",  # keep
    ],
    crate_root = "lib.rs",
    edition = "2024",
    deps = [
        "@crates//:chrono",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tempfile",
        "@crates//:thiserror",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "acceptance_test",
    size = "small",
    srcs = [
        "acceptance_test.rs",
        "adapter_test.rs",
    ],
    crate_root = "acceptance_test.rs",
    edition = "2024",
    env = {"RUST_TEST_THREADS": "1"},
    deps = [
        ":software_factory",
        "@crates//:googletest",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)

rust_test(
    name = "worker_test",  # keep
    size = "small",
    srcs = [
        "native_worker_test.rs",  # keep
        "worker_test.rs",
    ],
    crate_root = "worker_test.rs",
    data = ["//tools/pool_receipt"],  # keep
    edition = "2024",
    env = {"POOL_WRAPPER": "$(rootpath //tools/pool_receipt:pool_receipt)"},  # keep
    deps = [
        ":software_factory",
        "@crates//:googletest",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)

filegroup(
    name = "markdown",
    srcs = [
        "ACCEPTANCE.md",
        "README.md",
    ],
    tags = ["markdown"],
)
