load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@rules_java//java:defs.bzl", "java_import")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//tools/coverage:javascript.bzl", "js_test")
load("//tools/coverage:jvm.bzl", "java_binary")
load("//tools/coverage:rust.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/python:defs.bzl", "py_binary", "py_test")

sh_binary(
    name = "coverage",
    srcs = ["coverage.sh"],
    visibility = ["//:__subpackages__"],
)

py_binary(
    name = "discovery_test",
    testonly = True,
    srcs = ["discovery_test.py"],
    tags = ["manual"],
)

py_binary(
    name = "inventory",
    srcs = ["inventory.py"],
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "markdown",
    srcs = ["README.md"],
    tags = ["markdown"],
    visibility = ["//tools/lint:__pkg__"],
)

py_test(
    name = "inventory_test",
    size = "small",
    srcs = ["inventory_test.py"],
    args = [
        "-o",
        "python_files=inventory_test.py",
    ],
    data = [":inventory"],
    env = {"COVERAGE_CORE": "ctrace"},
)

py_binary(
    name = "go_membership_test",
    testonly = True,
    srcs = ["go_membership_test.py"],
    tags = ["manual"],
)

rust_binary(
    name = "go_report",
    srcs = ["go_report.rs"],
    crate_root = "go_report.rs",
    deps = [
        ":coverage_reports",
        "@crates//:clap",
    ],
)

py_test(
    name = "go_report_test",
    size = "small",
    srcs = ["go_report_test.py"],
    args = [
        "-o",
        "python_files=go_report_test.py",
    ],
    data = [":go_report"],
    env = {"COVERAGE_CORE": "ctrace"},
)

py_binary(
    name = "rust_membership_test",
    testonly = True,
    srcs = ["rust_membership_test.py"],
    tags = ["manual"],
)

py_binary(
    name = "rust_baseline",
    srcs = ["rust_baseline.py"],
)

native_binary(
    name = "llvm-readobj",
    src = "@llvm//tools:llvm-readobj",
    out = "llvm-readobj",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "rust_elf_coverage",
    constraint_values = ["@platforms//os:linux"],
    values = {"collect_code_coverage": "true"},
    visibility = ["//visibility:public"],
)

py_test(
    name = "rust_baseline_test",
    size = "small",
    srcs = ["rust_baseline_test.py"],
    args = [
        "-o",
        "python_files=rust_baseline_test.py",
    ],
    data = [
        "rust_membership_test.py",
        ":rust_baseline",
        "//tools/coverage/fixtures/rust_baseline:lib",
        "@llvm//tools:llvm-ar",
        "@llvm//tools:llvm-cov",
        "@llvm//tools:llvm-profdata",
    ],
    env = {
        "BASELINE_FIXTURE": "$(rootpath //tools/coverage/fixtures/rust_baseline:lib)",
        "COVERAGE_CORE": "ctrace",
        "LLVM_AR": "$(rootpath @llvm//tools:llvm-ar)",
        "LLVM_COV": "$(rootpath @llvm//tools:llvm-cov)",
        "LLVM_PROFDATA": "$(rootpath @llvm//tools:llvm-profdata)",
    },
)

py_binary(
    name = "jvm_membership_test",
    testonly = True,
    srcs = ["jvm_membership_test.py"],
    tags = ["manual"],
)

java_binary(
    name = "jvm_analyzer",
    srcs = ["JvmReport.java"],
    main_class = "coverage.JvmReport",
    visibility = ["//visibility:public"],
    deps = [":jacoco"],
)

exports_files(["jvm.bzl"])

rust_binary(
    name = "jvm_report",
    srcs = ["jvm_report.rs"],
    crate_root = "jvm_report.rs",
    data = [":jvm_analyzer"],
    deps = [
        ":coverage_reports",
        "@crates//:clap",
    ],
)

java_import(
    name = "jacoco",
    jars = [
        "@remote_java_tools//:java_tools/third_party/java/jacoco/org.jacoco.core-0.8.14.jar",
        "@remote_java_tools//:java_tools/third_party/java/jacoco/org.jacoco.report-0.8.14.jar",
        "@remote_java_tools//:java_tools/third_party/java/jacoco/asm-9.10.jar",
        "@remote_java_tools//:java_tools/third_party/java/jacoco/asm-commons-9.10.jar",
        "@remote_java_tools//:java_tools/third_party/java/jacoco/asm-tree-9.10.jar",
    ],
    visibility = ["//tools/coverage:__subpackages__"],
)

py_test(
    name = "jvm_report_test",
    size = "small",
    srcs = ["jvm_report_test.py"],
    args = [
        "-o",
        "python_files=jvm_report_test.py",
    ],
    data = [
        "JvmReport.java",
        ":jvm_analyzer",
        ":jvm_analyzer.jar",
        ":jvm_report",
        "//tools/coverage/fixtures/jvm_profile:Marker.java",
        "//tools/coverage/fixtures/jvm_profile:Profile.java",
        "//tools/coverage/fixtures/jvm_profile:profile",
        "//tools/coverage/fixtures/jvm_profile:profile.jar",
        "//tools/coverage/fixtures/jvm_profile:profile_variant",
        "//tools/coverage/fixtures/jvm_profile:profile_variant.jar",
    ],
    env = {"COVERAGE_CORE": "ctrace"},
)

js_binary(
    name = "javascript_baseline",
    data = ["@aspect_rules_js//js/private/coverage:coverage.js"],
    entry_point = "javascript_baseline.cjs",
    env = {"NATIVE_JAVASCRIPT_COLLECTOR": "$(rootpath @aspect_rules_js//js/private/coverage:coverage.js)"},
    no_copy_to_bin = ["@aspect_rules_js//js/private/coverage:coverage.js"],
)

js_test(
    name = "vitest_adapter_test",
    size = "small",
    data = ["//angular/bzl:vitest_coverage"],
