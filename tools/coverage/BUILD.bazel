        "COVERAGE_CORE": "ctrace",
        "JAVASCRIPT_COLLECTOR": "$(rootpath :javascript_baseline)",
        "JAVASCRIPT_LCOV_MERGER": "$(rootpath @bazel_tools//tools/test:lcov_merger)",
    },
)

py_binary(
    name = "javascript_membership_test",
    testonly = True,
    srcs = ["javascript_membership_test.py"],
    tags = ["manual"],
)

