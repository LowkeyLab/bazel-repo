load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//tools/python:defs.bzl", "py_binary", "py_test")

sh_binary(
    name = "coverage",
    srcs = ["coverage.sh"],
    visibility = ["//:__subpackages__"],
)

py_binary(
    name = "discovery_test",
    testonly = True,
    srcs = ["discovery_test.py"],
    tags = ["manual"],
)

py_binary(
    name = "inventory",
    srcs = ["inventory.py"],
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "markdown",
    srcs = ["README.md"],
    tags = ["markdown"],
    visibility = ["//tools/lint:__pkg__"],
)

py_test(
    name = "inventory_test",
    size = "small",
    srcs = ["inventory_test.py"],
    args = [
        "-o",
        "python_files=inventory_test.py",
    ],
    data = [":inventory"],
    env = {"COVERAGE_CORE": "ctrace"},
)

py_binary(
    name = "go_membership_test",
    testonly = True,
    srcs = ["go_membership_test.py"],
    tags = ["manual"],
)

py_binary(
    name = "go_report",
    srcs = ["go_report.py"],
)

py_test(
    name = "go_report_test",
    size = "small",
    srcs = ["go_report_test.py"],
    args = [
        "-o",
        "python_files=go_report_test.py",
    ],
    data = [":go_report"],
    env = {"COVERAGE_CORE": "ctrace"},
)

py_binary(
    name = "rust_membership_test",
    testonly = True,
    srcs = ["rust_membership_test.py"],
    tags = ["manual"],
)

py_binary(
    name = "rust_baseline",
    srcs = ["rust_baseline.py"],
)

native_binary(
    name = "llvm-readobj",
    src = "@llvm//tools:llvm-readobj",
    out = "llvm-readobj",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "rust_elf_coverage",
    constraint_values = ["@platforms//os:linux"],
    values = {"collect_code_coverage": "true"},
    visibility = ["//visibility:public"],
)

py_test(
    name = "rust_baseline_test",
    size = "small",
    srcs = ["rust_baseline_test.py"],
    args = [
        "-o",
        "python_files=rust_baseline_test.py",
    ],
    data = [
        ":rust_baseline",
        "//tools/coverage/fixtures/rust_baseline:lib",
        "@llvm//tools:llvm-ar",
        "@llvm//tools:llvm-cov",
        "@llvm//tools:llvm-profdata",
    ],
    env = {
        "BASELINE_FIXTURE": "$(rootpath //tools/coverage/fixtures/rust_baseline:lib)",
        "COVERAGE_CORE": "ctrace",
        "LLVM_AR": "$(rootpath @llvm//tools:llvm-ar)",
        "LLVM_COV": "$(rootpath @llvm//tools:llvm-cov)",
        "LLVM_PROFDATA": "$(rootpath @llvm//tools:llvm-profdata)",
    },
)
