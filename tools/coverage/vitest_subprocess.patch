+// Node resolves subprocess entry-point symlinks outside Bazel's logical roots.
+// Match only existing files admitted by the provider's unchanged root and filters.
+async function createRunfilesUrlResolver(provider) {
+    if (!process.env.TEST_SRCDIR || !process.env.TEST_WORKSPACE) return (url) => url;
+    const logicalUrls = new Set();
+    const aliases = new Map();
+    // rules_js retains this operation for integrations that need physical paths.
+    const realpath = fs._unpatched?.realpathSync || fs.realpathSync;
+    for (const root of provider.roots) {
+        const sources = await provider.getUntestedFilesByRoot([], ['**/*'], root);
+        for (const logical of sources) {
+            if (!existsSync(logical)) continue;
+            const logicalUrl = pathToFileURL(logical).href;
+            const physicalUrl = pathToFileURL(realpath(logical)).href;
+            logicalUrls.add(logicalUrl);
+            aliases.set(physicalUrl, aliases.has(physicalUrl) && aliases.get(physicalUrl) !== logicalUrl ? null : logicalUrl);
+        }
+    }
+    return (url) => logicalUrls.has(url) ? url : (aliases.get(url) || url);
+}
