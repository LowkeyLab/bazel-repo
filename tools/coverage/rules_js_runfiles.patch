+// Node resolves a plain child's main-module symlink. Match only aliases of
+// manifest files, then give c8 their original runfiles URLs before it merges
+// profiles or adds zero baselines. Keep the raw V8 files unchanged.
+const manifestUrls = new Set(include.map((file) => pathToFileURL(path.resolve(pwd, file)).href))
+const aliases = new Map()
+for (const file of include) {
+    const original = path.resolve(pwd, file)
+    if (!fs.existsSync(original)) continue
+    const physical = pathToFileURL(fs.realpathSync(original)).href
+    const logical = pathToFileURL(original).href
+    aliases.set(physical, aliases.has(physical) && aliases.get(physical) !== logical ? null : logical)
+}
+const originalUrl = (url) => manifestUrls.has(url) ? url : (aliases.get(url) || url)
+const profileDirectory = fs.mkdtempSync(path.join(process.env.COVERAGE_DIR, '.runfiles-'))
+for (const file of fs.readdirSync(process.env.COVERAGE_DIR)) {
+    if (!fs.statSync(path.join(process.env.COVERAGE_DIR, file)).isFile()) continue
+    const bytes = fs.readFileSync(path.join(process.env.COVERAGE_DIR, file))
+    let profile
+    try {
+        profile = JSON.parse(bytes)
+    } catch {
+        fs.writeFileSync(path.join(profileDirectory, file), bytes)
+        continue
+    }
+    if (profile && Array.isArray(profile.result)) {
+        for (const script of profile.result) script.url = originalUrl(script.url)
+        if (profile['source-map-cache']) {
+            profile['source-map-cache'] = Object.fromEntries(
+                Object.entries(profile['source-map-cache']).map(([url, data]) => [originalUrl(url), data])
+            )
+        }
+    }
+    fs.writeFileSync(path.join(profileDirectory, file), JSON.stringify(profile))
+}
