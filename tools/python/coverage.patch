+            baseline = ctx.actions.declare_file(ctx.label.name + ".python-baseline.lcov")
+            arguments = ctx.actions.args()
+            arguments.add(baseline)
+            arguments.add_all(sources)
+            ctx.actions.run(
+                executable = ctx.executable.coverage_baseline,
+                arguments = [arguments],
+                inputs = sources,
+                outputs = [baseline],
+                mnemonic = "PythonCoverageBaseline",
+            )
+            baselines.append(baseline)
