+    first_party = not ctx.label.workspace_name and not ctx.label.package.startswith("3rdparty/")
+    production = first_party and not ctx.attr.testonly
+    source_attributes = (["srcs"] + extra_source_attributes) if production else []
+    baselines = []
+    if ctx.executable.coverage_baseline and ctx.coverage_instrumented():
+        sources = []
+        for attribute in source_attributes:
+            for source in getattr(ctx.files, attribute, []):
+                if source.is_source and not source.owner.workspace_name and source.extension == "py":
+                    sources.append(source)
