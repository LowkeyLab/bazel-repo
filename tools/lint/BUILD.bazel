"""Define linting tools
"""

load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@npm//:eslint/package_json.bzl", eslint_bin = "bin")
load("@rules_java//java:defs.bzl", "java_binary")

package(default_visibility = ["//:__subpackages__"])

eslint_bin.eslint_binary(name = "eslint")

java_binary(
    name = "pmd",
    main_class = "net.sourceforge.pmd.PMD",
    runtime_deps = ["@net_sourceforge_pmd"],
)

java_binary(
    name = "checkstyle",
    main_class = "com.puppycrawl.tools.checkstyle.Main",
    runtime_deps = ["@com_puppycrawl_tools_checkstyle//jar"],
)

bzl_library(
    name = "linters",
    srcs = ["linters.bzl"],
    deps = [
        "@aspect_rules_lint//lint:buf",
        "@aspect_rules_lint//lint:checkstyle",
        "@aspect_rules_lint//lint:eslint",
        "@aspect_rules_lint//lint:keep_sorted",
        "@aspect_rules_lint//lint:pmd",
        "@aspect_rules_lint//lint:ruff",
        "@aspect_rules_lint//lint:shellcheck",
    ],
)
