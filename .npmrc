# Configuration for pnpm
# See https://pnpm.io/npmrc

# Don't hoist packages to the root node_modules
# This is important for Bazel's hermeticity
public-hoist-pattern[]=

# Symlink node_modules structure
node-linker=hoisted

# Don't allow postinstall scripts to run outside of Bazel
# This ensures reproducibility
ignore-scripts=false
