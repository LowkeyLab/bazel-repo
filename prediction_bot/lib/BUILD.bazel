    crate_root = "tests/events_unit.rs",
    deps = [
        "@crates//:chrono",
        "@crates//:cloudevents-sdk",
        "@crates//:googletest",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:thiserror",
        "@crates//:uuid",
    ],
)

