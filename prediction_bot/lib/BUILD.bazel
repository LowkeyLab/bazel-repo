# gazelle:resolve rust cloudevents @crates//:cloudevents-sdk

load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//tools/test_images:defs.bzl", "image_data", "image_env")

package(default_visibility = ["//prediction_bot:__subpackages__"])

rust_library(
    name = "lib",
    srcs = [
        "src/announcements.rs",
        "src/announcements/persistence.rs",
        "src/announcements/render.rs",
        "src/announcements/tests.rs",
        "src/announcements/worker.rs",
        "src/audit.rs",
        "src/audit/logging.rs",
        "src/audit_tests.rs",
        "src/discord.rs",
        "src/discord/announcements.rs",
        "src/discord/bet.rs",
        "src/discord/bet/handler.rs",
        "src/discord/bet/tests.rs",
        "src/discord/resolve.rs",
        "src/discord/resolve_tests.rs",
        "src/discord/resolvers.rs",
        "src/discord/resolvers/add.rs",
        "src/discord/resolvers/remove.rs",
        "src/discord/transport.rs",
        "src/discord_tests.rs",
        "src/discord_ui.rs",
        "src/domain.rs",
        "src/domain_tests.rs",
        "src/events.rs",
        "src/lib.rs",
        "src/odds.rs",
        "src/store.rs",
        "src/types.rs",
    ],
    compile_data = [
        "//prediction_bot/migrations:001_event_store.sql",
        "//prediction_bot/migrations:002_application_login.sql",
        "//prediction_bot/migrations:003_announcements.sql",
        "tests/fixtures/member-enrolled.json",
    ],
    crate_name = "prediction_bot",
    crate_root = "src/lib.rs",
    deps = [
        "@crates//:chrono",
        "@crates//:cloudevents-sdk",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:serenity",
        "@crates//:sqlx",
        "@crates//:thiserror",
        "@crates//:tokio",
        # Used inside the emit! macro body, which Gazelle does not expand.
        "@crates//:tracing",  # keep
        "@crates//:uuid",
    ],
)

rust_test(
    name = "domain_test",
    size = "small",
    srcs = [
        "src/domain.rs",
        "src/domain_tests.rs",
        "src/types.rs",
    ],
    crate_root = "src/domain.rs",
    deps = [
        "@crates//:googletest",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:thiserror",
    ],
)

