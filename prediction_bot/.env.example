# Copy to .env and replace placeholders. Do not commit .env.
DISCORD_TOKEN=replace-with-bot-token
# Optional expected ID: startup always fetches authenticated application info and verifies a match.
DISCORD_APPLICATION_ID=
DATABASE_URL=postgres://prediction_bot_app:replace-with-runtime-password@localhost:5432/prediction_bot
MIGRATION_DATABASE_URL=postgres://prediction_owner:replace-with-owner-password@localhost:5432/prediction_bot
GRANT_AMOUNT=100
GRANT_INTERVAL_SECONDS=86400
POSTGRES_OWNER_PASSWORD=replace-with-owner-password
# Required by --migrate when creating prediction_bot_app; existing passwords are preserved.
POSTGRES_RUNTIME_PASSWORD=replace-with-runtime-password
