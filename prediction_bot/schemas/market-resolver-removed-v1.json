{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lowkeylab:prediction-bot:schema:market-resolver-removed:v1",
  "type": "object",
  "properties": {
    "kind": {
      "const": "market_resolver_removed"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "removed_by": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "removed_at": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    }
  },
  "required": ["kind", "id", "user_id", "removed_by", "removed_at"],
  "additionalProperties": false
}
