{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lowkeylab:prediction-bot:schema:market-cancelled:v1",
  "type": "object",
  "properties": {
    "kind": {
      "const": "market_cancelled"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "moderator": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "cancelled_at": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "refunds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "amount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          }
        },
        "required": ["user_id", "amount"],
        "additionalProperties": false
      }
    }
  },
  "required": ["kind", "id", "moderator", "cancelled_at", "refunds"],
  "additionalProperties": false
}
