{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lowkeylab:prediction-bot:schema:bet-placed:v1",
  "type": "object",
  "properties": {
    "kind": {
      "const": "bet_placed"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "outcome": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "amount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "accepted_at": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    }
  },
  "required": ["kind", "id", "user_id", "outcome", "amount", "accepted_at"],
  "additionalProperties": false
}
