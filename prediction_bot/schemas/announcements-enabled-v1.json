{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lowkeylab:prediction-bot:schema:announcements-enabled:v1",
  "type": "object",
  "properties": {
    "kind": {
      "const": "announcements_enabled"
    },
    "channel_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "moderator": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "enabled_at": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    }
  },
  "required": ["kind", "channel_id", "moderator", "enabled_at"],
  "additionalProperties": false
}
