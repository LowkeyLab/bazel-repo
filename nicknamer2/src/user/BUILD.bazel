load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "user_repo",
    srcs = ["repo.rs"],
    deps = [
        ":user",
        "@crates//:sqlx",
        "@crates//:thiserror",
    ],
)

rust_library(
    name = "user_service",
    srcs = ["service.rs"],
    deps = [
        ":user",
        ":user_repo",
    ],
)

rust_library(
    name = "user",
    srcs = ["user.rs"],
    visibility = ["//nicknamer2/src/name:__subpackages__"],
    deps = [
        "@crates//:chrono",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "user_service_test",
    timeout = "short",
    crate = ":user_service",
    tags = ["requires-network"],
    deps = [
        "//nicknamer2/src/migrations",
        "@crates//:sqlx",
        "@crates//:testcontainers-modules",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "user_test",
    size = "small",
    crate = ":user",
)
