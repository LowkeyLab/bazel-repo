load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "user",
    srcs = ["user.rs"],
    deps = [
        ":name",
        "@crates//:chrono",
        "@crates//:uuid",
    ],
)

rust_library(
    name = "name",
    srcs = ["name.rs"],
    deps = [
        "@crates//:chrono",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "user_test",
    size = "small",
    crate = ":user",
)

rust_test(
    name = "name_test",
    size = "small",
    crate = ":name",
)
