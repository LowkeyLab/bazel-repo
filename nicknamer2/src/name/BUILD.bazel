load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "name",
    srcs = ["name.rs"],
    visibility = ["//nicknamer2:__subpackages__"],
    deps = ["@crates//:chrono"],
)

rust_library(
    name = "name_repo",
    srcs = ["repo.rs"],
    visibility = ["//nicknamer2:__subpackages__"],
    deps = [
        ":name",
        "@crates//:anyhow",
        "@crates//:sqlx",
    ],
)

rust_library(
    name = "name_service",
    srcs = ["service.rs"],
    visibility = ["//nicknamer2:__subpackages__"],
    deps = [
        ":name",
        ":name_repo",
        "@crates//:anyhow",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "name_test",
    size = "small",
    crate = ":name",
)

rust_test(
    name = "name_repo_test",
    timeout = "short",
    crate = ":name_repo",
    tags = ["requires-network"],
    deps = [
        "//nicknamer2/src/migrations",
        "@crates//:testcontainers-modules",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "name_service_test",
    timeout = "short",
    crate = ":name_service",
    tags = ["requires-network"],
    deps = [
        "//nicknamer2/src/migrations",
        "@crates//:sqlx",
        "@crates//:testcontainers-modules",
        "@crates//:tokio",
    ],
)
