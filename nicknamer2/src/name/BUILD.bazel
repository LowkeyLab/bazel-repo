load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//tools/test_images:defs.bzl", "image_data", "image_env")

rust_library(
    name = "name",
    srcs = ["name.rs"],
    visibility = ["//nicknamer2:__subpackages__"],
    deps = ["@crates//:chrono"],
)

rust_library(
    name = "name_repo",
    srcs = ["repo.rs"],
    visibility = ["//nicknamer2:__subpackages__"],
    deps = [
        ":name",
        "@crates//:anyhow",
        "@crates//:sqlx",
    ],
)

rust_library(
    name = "name_service",
    srcs = ["service.rs"],
    visibility = ["//nicknamer2:__subpackages__"],
    deps = [
        ":name",
        ":name_repo",
        "@crates//:anyhow",
    ],
)

rust_test(
    name = "name_test",
    size = "small",
    crate = ":name",
)

rust_test(
    name = "name_repo_test",
    timeout = "short",
    crate = ":name_repo",
    data = image_data("postgres_18"),  # keep
    env = image_env("postgres_18"),
    exec_properties = {
        "test.workload-isolation-type": "firecracker",
        "test.init-dockerd": "true",
    },
    tags = [
        "requires-docker",
        "requires-network",
    ],
    deps = [
        "//nicknamer2/src/migrations",
        "//test_images/rust:test_images",  # keep
        "@crates//:testcontainers-modules",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "name_service_test",
    timeout = "short",
    crate = ":name_service",
    data = image_data("postgres_18"),  # keep
    env = image_env("postgres_18"),
    exec_properties = {
        "test.workload-isolation-type": "firecracker",
        "test.init-dockerd": "true",
    },
    tags = [
        "requires-docker",
        "requires-network",
    ],
    deps = [
        "//nicknamer2/src/migrations",
        "//test_images/rust:test_images",  # keep
        "@crates//:sqlx",
        "@crates//:testcontainers-modules",
        "@crates//:tokio",
    ],
)
