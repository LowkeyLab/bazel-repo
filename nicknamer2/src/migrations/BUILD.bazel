load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//tools/test_images:defs.bzl", "image_data", "image_env")

rust_library(
    name = "migrations",
    srcs = ["lib.rs"],
    compile_data = [
        "//nicknamer2/migrations",
    ],
    crate_root = "lib.rs",
    visibility = ["//nicknamer2:__subpackages__"],
    deps = ["@crates//:sqlx"],
)

rust_test(
    name = "migrations_test",
    timeout = "short",
    compile_data = [
        "//nicknamer2/migrations",
    ],
    crate = ":migrations",
    data = image_data("postgres_18"),
    env = image_env("postgres_18"),
    exec_properties = {
        "test.workload-isolation-type": "firecracker",
        "test.init-dockerd": "true",
    },
    tags = [
        "requires-docker",
        "requires-network",
    ],
    deps = [
        "//test_images/rust:test_images",
        "@crates//:testcontainers-modules",
        "@crates//:tokio",
    ],
)
