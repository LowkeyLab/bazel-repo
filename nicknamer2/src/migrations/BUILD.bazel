load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "migrations",
    srcs = ["migrations.rs"],
    compile_data = [
        "//nicknamer2/migrations",  # keep
    ],
    visibility = ["//nicknamer2:__subpackages__"],
    deps = ["@crates//:sqlx"],
)

rust_test(
    name = "migrations_test",
    timeout = "short",
    compile_data = [
        "//nicknamer2/migrations",  # keep
    ],
    crate = ":migrations",
    exec_properties = {
        "test.workload-isolation-type": "firecracker",
        "test.init-dockerd": "true",
    },
    tags = [
        "requires-docker",
        "requires-network",
    ],
    deps = [
        "@crates//:testcontainers-modules",
        "@crates//:tokio",
    ],
)
