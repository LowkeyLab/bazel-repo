load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//tools/test_images:defs.bzl", "image_data", "image_env")

go_library(
    name = "repository",
    srcs = [
        "memory.go",
        "postgres.go",
        "repository.go",
    ],
    importpath = "github.com/lowkeylab/bazel-repo/predix/internal/domain/user/repository",
    visibility = ["//predix:__subpackages__"],
    deps = [
        "//predix/internal/db",
        "//predix/internal/domain/user",
        "@com_github_google_uuid//:uuid",
    ],
)

go_test(
    name = "repository_test",
    size = "small",
    srcs = [
        "memory_test.go",
        "postgres_test.go",
    ],
    data = image_data("postgres_18") + image_data("ryuk"),  # keep
    env = image_env("postgres_18") | image_env(
        "ryuk",
        prefix = "RYUK",
    ),
    exec_properties = {
        "test.workload-isolation-type": "firecracker",
        "test.init-dockerd": "true",
    },
    tags = [
        # keep
        "requires-docker",
        "requires-network",
    ],
    deps = [
        ":repository",
        "//predix/internal/domain/user",
        "//predix/internal/testutil",
        "@com_github_google_uuid//:uuid",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
