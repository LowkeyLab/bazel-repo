load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "application",
    srcs = ["service.go"],
    importpath = "github.com/lowkeylab/bazel-repo/predix/internal/core/application",
    visibility = ["//visibility:public"],
    deps = [
        "//predix/domain/circle",
        "//predix/domain/contest",
        "//predix/domain/user",
        "@com_github_google_uuid//:uuid",
