load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//:pkg.bzl", "pkg_tar")
load("//tools/coverage:jvm.bzl", "java_binary", "kt_jvm_library")

kt_jvm_library(
    name = "ApplicationKt",
    srcs = ["Application.kt"],
    deps = [
        "//mindreadr/src/main/io/lowkeylab/mindreadr",
    ],
)

java_binary(
    name = "application",
    main_class = "io.lowkeylab.mindreadr.app.ApplicationKt",
    resource_strip_prefix = "mindreadr/src/main/resources",
    resources = ["//mindreadr/src/main/resources"],
    runtime_deps = [
        ":ApplicationKt",
        "@maven//:ch_qos_logback_logback_classic",
    ],
)

java_binary(
    name = "application_dev",
    args = ["-config=application-dev.conf"],
    main_class = "io.lowkeylab.mindreadr.app.ApplicationKt",
    resource_strip_prefix = "mindreadr/src/main/resources",
    resources = ["//mindreadr/src/main/resources"],
    visibility = ["//mindreadr:__pkg__"],
    runtime_deps = [
        ":ApplicationKt",
        "@maven//:ch_qos_logback_logback_classic",
    ],
)

pkg_tar(
    name = "app_layer",
    srcs = [":application_deploy.jar"],
    package_dir = "/app",
)

oci_image(
    name = "app_image",
    base = "@distroless_java25",
    entrypoint = [
        "java",
        "-jar",
        "/app/application_deploy.jar",
    ],
    tars = [":app_layer"],
    visibility = ["//mindreadr:__pkg__"],
)

oci_load(
    name = "load_app_image",
    image = ":app_image",
    repo_tags = ["lowkeylab/mindreadr:latest"],
)

oci_push(
    name = "push_app_image",
    image = ":app_image",
    remote_tags = ["latest"],
    repository = "ghcr.io/lowkeylab/mindreadr_backend",
    visibility = ["//mindreadr:__pkg__"],
)
