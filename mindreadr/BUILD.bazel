alias(
    name = "mindreadr",
    actual = "//mindreadr/src/main/io/lowkeylab/mindreadr/app:application_dev",
)

alias(
    name = "image",
    actual = "//mindreadr/src/main/io/lowkeylab/mindreadr/app:app_image",
)

alias(
    name = "push_image",
    actual = "//mindreadr/src/main/io/lowkeylab/mindreadr/app:push_app_image",
)

# Prose lint covers Markdown in this package, including nested non-package directories.
filegroup(
    name = "markdown",
    srcs = glob(
        ["**/*.md"],
        exclude = [
            "**/node_modules/**",
            "**/target/**",
            ".*/**",
        ],
    ),
    tags = ["markdown"],
    visibility = ["//tools/lint:__pkg__"],
)
