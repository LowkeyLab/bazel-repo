load("@rules_rs//rs:rust_library.bzl", "rust_library")

package(default_visibility = ["//nicknamer"])

filegroup(
    name = "templates",
    srcs = glob(["templates/**/*"]),
)

rust_library(
    name = "lib",
    srcs = [
        "src/auth/api/mod.rs",
        "src/auth/api/v1.rs",
        "src/auth/mod.rs",
        "src/entities/mod.rs",
        "src/entities/name.rs",
        "src/entities/prelude.rs",
        "src/lib.rs",
        "src/name/api/mod.rs",
        "src/name/api/v1.rs",
        "src/name/mod.rs",
        "src/name/web.rs",
        "src/observations/http.rs",
        "src/observations/lifecycle.rs",
        "src/observations/logging.rs",
        "src/observations/mod.rs",
        "src/observations/otlp.rs",
        "src/web/api.rs",
        "src/web/mod.rs",
    ],
    compile_data = [":templates"],
    crate_name = "nicknamer_server",
    crate_root = "src/lib.rs",
    deps = [
        "//nicknamer/migration/lib",
        "@crates//:anyhow",
        "@crates//:askama",
        "@crates//:axum",
        "@crates//:axum-extra",
        "@crates//:chrono",
        # External crate used inside the same-named local config module.
        "@crates//:config",  # keep
        "@crates//:jsonwebtoken",
        "@crates//:opentelemetry-proto",
        "@crates//:opentelemetry_sdk",
        "@crates//:sea-orm",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:serde_yaml",
        "@crates//:thiserror",
        "@crates//:time",
        "@crates//:tokio",
        "@crates//:tower",
        "@crates//:tower-http",
        "@crates//:tracing",
        "@crates//:utoipa",
        "@crates//:utoipa-swagger-ui",
        "@crates//:uuid",
    ],
)
