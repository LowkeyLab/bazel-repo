load("@rules_rs//rs:rust_library.bzl", "rust_library")

package(default_visibility = ["//nicknamer"])

filegroup(
    name = "templates",
    srcs = glob(["templates/**/*"]),
)

rust_library(
    name = "lib",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [":templates"],
    crate_name = "nicknamer_server",
    deps = [
        "//nicknamer/migration/lib",
        "@crates//:anyhow",
        "@crates//:askama",
        "@crates//:axum",
        "@crates//:axum-extra",
        "@crates//:chrono",
        "@crates//:config",
        "@crates//:jsonwebtoken",
        "@crates//:sea-orm",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:serde_yaml",
        "@crates//:thiserror",
        "@crates//:time",
        "@crates//:tokio",
        "@crates//:tower",
        "@crates//:tower-http",
        "@crates//:tracing",
        "@crates//:tracing-futures",
        "@crates//:tracing-subscriber",
        "@crates//:utoipa",
        "@crates//:utoipa-swagger-ui",
        "@crates//:uuid",
    ],
)
