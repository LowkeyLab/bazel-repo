# gazelle:resolve rust cloudevents @crates//:cloudevents-sdk

load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "lib",
    srcs = [
        "cloudevents.rs",
        "cloudevents_tests.rs",
        "command.rs",
        "command_tests.rs",
        "error.rs",
        "event.rs",
        "identity.rs",
        "lib.rs",
        "notice.rs",
        "projection.rs",
    ],
    crate_name = "book_smartz_domain",
    crate_root = "lib.rs",
    deps = [
        "@crates//:chrono",
        "@crates//:cloudevents-sdk",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:thiserror",
        "@crates//:url",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "domain_test",
    size = "small",
    crate = ":lib",
    deps = [
        "@crates//:chrono",
        "@crates//:googletest",
        "@crates//:serde_json",
        "@crates//:uuid",
    ],
)
