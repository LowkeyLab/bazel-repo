    data = [
        ":bin",
        ":package",
    ] + image_data("postgres_18"),
    env = image_env("postgres_18") | {"PACKAGE_ARCHIVE": "$(rlocationpath :package)"},
    exec_properties = {
        "test.workload-isolation-type": "firecracker",
        "test.init-dockerd": "true",
    },
    tags = [
        "requires-docker",
        "requires-network",
    ],
    deps = [
        "//book_smartz/domain:lib",
        "//book_smartz/storage:lib",
        "//test_images/rust:test_images",
        "@crates//:anyhow",
        "@crates//:base64",
        "@crates//:chrono",
        "@crates//:googletest",
        "@crates//:jsonwebtoken",
        "@crates//:regex",
        "@crates//:reqwest",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:sqlx",
        "@crates//:tar",
        "@crates//:tempfile",
        "@crates//:testcontainers-modules",
        "@crates//:tokio",
        "@crates//:url",
        "@crates//:uuid",
        "@crates//:wiremock",
        "@rules_rust//tools/runfiles",
    ],
