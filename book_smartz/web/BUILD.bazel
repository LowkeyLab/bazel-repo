    exec_properties = {
        "test.workload-isolation-type": "firecracker",
        "test.init-dockerd": "true",
    },
    tags = [
        "requires-docker",
        "requires-network",
    ],
    deps = [
        "//book_smartz/domain:lib",
        "//book_smartz/storage:lib",
        "//test_images/rust:test_images",
        "@crates//:anyhow",
        "@crates//:base64",
        "@crates//:chrono",
        "@crates//:googletest",
        "@crates//:jsonwebtoken",
        "@crates//:regex",
        "@crates//:reqwest",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:sqlx",
        "@crates//:tar",
        "@crates//:tempfile",
        "@crates//:testcontainers-modules",
        "@crates//:tokio",
        "@crates//:url",
        "@crates//:uuid",
        "@crates//:wiremock",
        "@rules_rust//tools/runfiles",
    ],
)

rust_test(
    name = "package_test",
    size = "medium",
    srcs = [
        "package_test.rs",
        "test_support.rs",
    ],
    compile_data = ["fixtures/public-test-key.pem"],
    crate_root = "package_test.rs",
    data = [
        ":package",
        ":run",
    ] + image_data("postgres_18"),
    env = image_env("postgres_18") | {
        "PACKAGE_ARCHIVE": "$(rlocationpath :package)",
        "RUN_LAUNCHER": "$(rlocationpath :run)",
    },
    exec_properties = {
        "test.workload-isolation-type": "firecracker",
        "test.init-dockerd": "true",
    },
    tags = [
        "requires-docker",
        "requires-network",
    ],
    deps = [
        "//book_smartz/domain:lib",
        "//book_smartz/storage:lib",
        "//test_images/rust:test_images",
        "@crates//:anyhow",
        "@crates//:base64",
        "@crates//:chrono",
        "@crates//:googletest",
        "@crates//:jsonwebtoken",
        "@crates//:regex",
        "@crates//:reqwest",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:sqlx",
        "@crates//:tar",
        "@crates//:tempfile",
        "@crates//:testcontainers-modules",
        "@crates//:tokio",
        "@crates//:url",
        "@crates//:uuid",
        "@crates//:wiremock",
        "@rules_rust//tools/runfiles",
    ],
)

filegroup(
    name = "markdown",
    srcs = glob(["**/*.md"]),
    tags = ["markdown"],
    visibility = ["//tools/lint:__pkg__"],
)
