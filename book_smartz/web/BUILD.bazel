# Custom Topcoat metadata and generated assets are maintained through the declared wrapper interface.
# gazelle:ignore
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("//tools/coverage:javascript.bzl", "js_test")
load("//tools/coverage:rust.bzl", "rust_binary", "rust_test")
load("//tools/test_images:defs.bzl", "image_data", "image_env")
load("//tools/topcoat:defs.bzl", "topcoat_assets", "topcoat_package", "topcoat_rust_binary", "topcoat_rust_library", "topcoat_tailwind")

package(default_visibility = ["//visibility:public"])

topcoat_rust_library(
    name = "views",
    package_name = "book-smartz-views",
    srcs = ["views.rs"],
    asset_inputs = [
        "fonts/literata.ttf",
        "fonts/source-sans-3.ttf",
        "fonts/literata-OFL.txt",
        "fonts/source-sans-3-OFL.txt",
        "cover-placeholder.svg",
    ],
    crate_name = "book_smartz_views",
    crate_root = "views.rs",
    iconify_json = ":icons",
    macro_dependencies = {"topcoat": "topcoat"},
    deps = ["@crates//:topcoat"],
)

topcoat_rust_binary(
    name = "bin",
    package_name = "book-smartz-web",
    srcs = [
        "actions.rs",
        "actions/evidence.rs",
        "catalog.rs",
        "catalog/admission.rs",
        "catalog/cache.rs",
        "catalog/metadata.rs",
        "diagnostic_events.rs",
        "diagnostics.rs",
        "feedback.rs",
        "identity.rs",
        "initialization.rs",
        "main.rs",
        "package.rs",
    ],
    asset_inputs = [
        ":styles",
        ":submitting_script",
    ],
    compile_data = [
        "actions.sql",
        "identity.sql",
        "catalog.sql",
        "catalog/cache.sql",
    ],
    crate_name = "book_smartz_web",
    crate_root = "main.rs",
    macro_dependencies = {"topcoat": "topcoat"},
    topcoat_deps = [":views_topcoat_inputs"],
    deps = [
        ":views",
        "//book_smartz/domain:lib",
        "//book_smartz/storage:lib",
        "@crates//:anyhow",
        "@crates//:base64",
        "@crates//:chrono",
        "@crates//:jsonwebtoken",
        "@crates//:reqwest",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:sqlx",
        "@crates//:thiserror",
        "@crates//:tokio",
        "@crates//:topcoat",
        "@crates//:url",
        "@crates//:uuid",
    ],
)

genrule(
    name = "icons",
    srcs = ["//tools:node_modules/@iconify-json/feather"],
    outs = ["local/topcoat-icon-iconify/feather.json"],
    cmd = "for p in $(execpaths //tools:node_modules/@iconify-json/feather); do case $$p in */tools/node_modules/@iconify-json/feather) cp $$p/icons.json $@ ;; esac; done",
)

topcoat_tailwind(
    name = "styles",
    srcs = [
        "actions.rs",
        "catalog.rs",
        "main.rs",
        "views.rs",
    ],
    cli = "//tools:tailwindcss",
    css = "input.css",
    deps = ["//:node_modules/tailwindcss"],
)

topcoat_assets(
    name = "assets",
    srcs = [
        ":bin_topcoat_inputs",
        "@crates//:topcoat_runtime_assets",
    ],
)

topcoat_package(
    name = "package",
    binary = ":bin",
    executable_name = "book-smartz",
    inputs = [":assets"],
)

rust_binary(
    name = "run",
    srcs = ["run.rs"],
    crate_root = "run.rs",
    data = [":package"],
    env = {"PACKAGE_ARCHIVE": "$(rlocationpath :package)"},
    deps = [
        "@crates//:anyhow",
        "@crates//:tar",
        "@crates//:tempfile",
        "@rules_rust//tools/runfiles",
    ],
)

rust_test(
    name = "http_test",
    size = "medium",
    srcs = [
        "catalog_test.rs",
        "diagnostic_events.rs",
        "diagnostic_test.rs",
        "fixture_process.rs",  # keep
        "http_test.rs",
        "identity_diagnostic_test.rs",
        "identity_test.rs",
        "test_support.rs",
    ],
    compile_data = ["fixtures/public-test-key.pem"],
    crate_root = "http_test.rs",
    data = [
        ":bin",
        ":package",
    ] + image_data("postgres_18"),
    env = image_env("postgres_18") | {"PACKAGE_ARCHIVE": "$(rlocationpath :package)"},
    exec_properties = {
        "test.workload-isolation-type": "firecracker",
        "test.init-dockerd": "true",
    },
    tags = [
        "requires-docker",
        "requires-network",
    ],
    deps = [
        "//test_images/rust:test_images",
        "@crates//:anyhow",
        "@crates//:base64",
        "@crates//:chrono",
        "@crates//:googletest",
        "@crates//:jsonwebtoken",
        "@crates//:regex",
        "@crates//:reqwest",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:sqlx",
        "@crates//:tar",
        "@crates//:tempfile",
        "@crates//:testcontainers-modules",
        "@crates//:tokio",
        "@crates//:url",
        "@crates//:uuid",
        "@crates//:wiremock",
        "@rules_rust//tools/runfiles",
    ],
)

