rust_test(
    name = "package_test",
    size = "medium",
    srcs = [
        "diagnostic_events.rs",
        "fixture_process.rs",  # keep
        "package_test.rs",
        "test_support.rs",
    ],
    compile_data = ["fixtures/public-test-key.pem"],
    crate_root = "package_test.rs",
    data = [
        ":bin",
        ":package",
        ":run",
    ] + image_data("postgres_18"),
    env = image_env("postgres_18") | {
        "PACKAGE_ARCHIVE": "$(rlocationpath :package)",
        "RUN_LAUNCHER": "$(rlocationpath :run)",
    },
    exec_properties = {
        "test.workload-isolation-type": "firecracker",
        "test.init-dockerd": "true",
    },
    tags = [
        "requires-docker",
        "requires-network",
    ],
    deps = [
        "//book_smartz/domain:lib",
        "//book_smartz/storage:lib",
        "//test_images/rust:test_images",
        "@crates//:anyhow",
        "@crates//:base64",
        "@crates//:chrono",
        "@crates//:googletest",
        "@crates//:jsonwebtoken",
        "@crates//:regex",
        "@crates//:reqwest",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:sqlx",
        "@crates//:tar",
        "@crates//:tempfile",
        "@crates//:testcontainers-modules",
        "@crates//:tokio",
        "@crates//:url",
        "@crates//:uuid",
        "@crates//:wiremock",
        "@rules_rust//tools/runfiles",
    ],
)

filegroup(
    name = "markdown",
    srcs = glob(["**/*.md"]),
    tags = ["markdown"],
    visibility = ["//tools/lint:__pkg__"],
)

js_binary(
    name = "browser_runner",
    testonly = True,
    data = [
        "browser.journey.mjs",
        ":browser_lifecycle",
        "//:node_modules/playwright",
    ],
    entry_point = "browser.journey.mjs",
)

rust_test(
    name = "browser_test",
    size = "medium",
    srcs = [
        "browser_test.rs",
        "fixture_process.rs",  # keep
        "test_support.rs",
    ],
    compile_data = ["fixtures/public-test-key.pem"],
    crate_root = "browser_test.rs",
    data = [
        "fixtures/browser-test-certificate.pem",
        "fixtures/public-test-key.pem",
        ":bin",
        ":browser_runner",
        ":package",
    ] + image_data("postgres_18"),
    env = image_env("postgres_18") | {
        "PACKAGE_ARCHIVE": "$(rlocationpath :package)",
        "BROWSER_RUNNER": "$(rlocationpath :browser_runner)",
        "BROWSER_KEY": "$(rlocationpath fixtures/public-test-key.pem)",
        "BROWSER_CERTIFICATE": "$(rlocationpath fixtures/browser-test-certificate.pem)",
        "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright",
    },
    exec_properties = {
        "test.container-image": "docker://ghcr.io/lowkeylab/book_smartz_browser_worker@sha256:6fdbf236c09d41b4bc82d140ea6f5510eb27de20d422f4fa88b64cf59413990f",
        "test.workload-isolation-type": "firecracker",
        "test.init-dockerd": "true",
    },
    # Explicit --test_env overrides support host-browser smoke runs. Do not
    # inherit developer browser paths into the remote worker environment.
    tags = [
        "requires-docker",
        "requires-network",
    ],
    deps = [
        "//test_images/rust:test_images",
        "@crates//:anyhow",
        "@crates//:base64",
        "@crates//:chrono",
        "@crates//:googletest",
        "@crates//:jsonwebtoken",
        "@crates//:regex",
        "@crates//:reqwest",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:sqlx",
        "@crates//:tar",
        "@crates//:tempfile",
        "@crates//:testcontainers-modules",
        "@crates//:tokio",
        "@crates//:url",
        "@crates//:uuid",
        "@crates//:wiremock",
        "@rules_rust//tools/runfiles",
    ],
)

js_library(
    name = "submitting_script",
    srcs = ["submitting.js"],
)

js_library(
    name = "scripts",
    testonly = True,
    srcs = ["browser.journey.mjs"],
    deps = [
        ":browser_lifecycle",
        ":submitting_script",
        "//:node_modules/playwright",
    ],
)

oci_image(
    name = "image",
    base = "@distroless_cc",
    cmd = ["serve"],
    entrypoint = ["/book-smartz"],
    env = {"HOST": "0.0.0.0"},
    tars = [":package"],
)

oci_push(
    name = "push_image",
    image = ":image",
    remote_tags = ["latest"],
    repository = "ghcr.io/lowkeylab/book_smartz",
)

oci_load(
    name = "load_image",
    image = ":image",
    repo_tags = ["local/book-smartz:latest"],
)

# Exercise private behavior in the same application crate.
rust_test(
    name = "evidence_test",
    size = "small",
    crate = ":bin",
    deps = [
        "@crates//:googletest",
        "@crates//:wiremock",
    ],
)

# This collector executes the existing packaged journey, with native Node profiles.
_BROWSER_COLLECTION_DATA = [
    "fixtures/browser-test-certificate.pem",
    "fixtures/public-test-key.pem",
    ":browser_runner",
    ":browser_test",
    ":package",
    ":scripts",
] + image_data("postgres_18")

_BROWSER_COLLECTION_ENV = image_env("postgres_18") | {
    "BROWSER_FIXTURE": "$(rootpath :browser_test)",
    "PACKAGE_ARCHIVE": "$(rlocationpath :package)",
    "BROWSER_RUNNER": "$(rlocationpath :browser_runner)",
    "BROWSER_KEY": "$(rlocationpath fixtures/public-test-key.pem)",
    "BROWSER_CERTIFICATE": "$(rlocationpath fixtures/browser-test-certificate.pem)",
    "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright",
}

_BROWSER_COLLECTION_EXEC_PROPERTIES = {
    "test.container-image": "docker://ghcr.io/lowkeylab/book_smartz_browser_worker@sha256:6fdbf236c09d41b4bc82d140ea6f5510eb27de20d422f4fa88b64cf59413990f",
    "test.workload-isolation-type": "firecracker",
    "test.init-dockerd": "true",
}

js_test(
    name = "browser_collection_test",
    size = "medium",
    timeout = "long",
    data = _BROWSER_COLLECTION_DATA,
    entry_point = "browser.collection.mjs",
    env = _BROWSER_COLLECTION_ENV,
    exec_properties = _BROWSER_COLLECTION_EXEC_PROPERTIES,
    tags = [
        "requires-docker",
        "requires-network",
    ],
)

# A closed diagnostic pipe must preserve the real packaged journey and cleanup.
js_test(
    name = "browser_diagnostic_failure_test",
    size = "medium",
    timeout = "long",
    data = _BROWSER_COLLECTION_DATA,
    entry_point = "browser.collection.mjs",
    env = _BROWSER_COLLECTION_ENV | {"BOOK_SMARTZ_BROWSER_CLOSE_DIAGNOSTIC_PIPE": "1"},
    exec_properties = _BROWSER_COLLECTION_EXEC_PROPERTIES,
    tags = [
        "requires-docker",
        "requires-network",
    ],
)

js_test(
    name = "browser_lifecycle_test",
    size = "small",
    data = [":browser_lifecycle_tests"],
    entry_point = "browser.lifecycle.test.mjs",
)

js_library(
    name = "browser_lifecycle",
    testonly = True,
    srcs = ["browser.lifecycle.mjs"],
)

js_library(
    name = "browser_lifecycle_tests",
    testonly = True,
    srcs = ["browser.lifecycle.test.mjs"],
    deps = [":browser_lifecycle"],
)

