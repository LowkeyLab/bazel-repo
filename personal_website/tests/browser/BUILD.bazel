load("@aspect_rules_js//js:defs.bzl", "js_test")
load("//personal_website/bzl:ts.bzl", "personal_website_ts_library", "personal_website_ts_test_sources")

test_suite(
    name = "tests",
    tests = [
        ":featured_work_test",
        ":hero_test",
        ":homepage_test",
        ":recent_writing_test",
    ],
)

js_test(
    name = "homepage_test",
    size = "large",
    data = [
        ":browser_test",
        "//personal_website:build",
    ],
    entry_point = "homepage.test.js",
    env = {
        "SITE_DIR": "$(rootpath //personal_website:build)",
    },
    exec_properties = {
        "container-image": "docker://mcr.microsoft.com/playwright@sha256:06a9939e57531807f8d5fd76ce44b53165ffb7d7501d87ab10e285c20b1e971f",
    },
)

