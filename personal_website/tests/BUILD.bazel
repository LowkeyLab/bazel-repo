load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//personal_website/bzl:ts.bzl", "personal_website_ts_test_sources")

# gazelle:map_kind ts_test personal_website_ts_test_sources //personal_website/bzl:ts.bzl

# The fixture config imports its production counterpart across package roots;
# Astro's fixture build validates this test-only config directly.
# gazelle:exclude fixtures.config.ts
# gazelle:exclude fixtures/posts.ts

copy_to_bin(
    name = "fixture_sources",
    srcs = [
        "empty/.gitkeep",
        "fixtures.config.ts",
    ] + glob([
        "fixtures/*.astro",
        "fixtures/*.ts",
    ]),
    visibility = ["//personal_website:__pkg__"],
)

alias(
    name = "fixtures_build",
    actual = "//personal_website:fixtures_build",
    visibility = ["//visibility:public"],
)

js_test(
    name = "blog_test",
    size = "small",
    data = [":tests_test"],
    entry_point = "blog.test.js",
)

personal_website_ts_test_sources(
    name = "tests_test",
    srcs = ["blog.test.ts"],
    tsconfig_types = ["node"],
    deps = [
        "//:node_modules/@types/node",
        "//personal_website/src/utils",
    ],
)
