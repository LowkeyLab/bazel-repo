---
import { render, getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import TagBadges from "../../components/TagBadges.astro";
import Prose from "../../components/Prose.astro";
import { calculateReadingTime } from "../../utils/blog";
export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Layout title={`${post.data.title} | Tim Tran`} description={post.data.description} activeItem="blog" noindex={post.data.draft} article={post.data.draft ? undefined : post.data}>
  <article class="reading-page">
    <a href="/blog/" class="ink-link">← Back to blog</a>
    <header class="reading-header">
      <h1>{post.data.title}</h1>
      <div class="reading-meta">
        <span class="entry-type">{post.data.type[0].toUpperCase() + post.data.type.slice(1)}</span>
        {post.data.context && <span class="reading-context">{post.data.context}</span>}
        <time datetime={post.data.publishDate.toISOString()}>{new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric" }).format(post.data.publishDate)}</time>
        <span>{calculateReadingTime(post.body || "")} min read</span>
      </div>
      <TagBadges tags={post.data.tags} />
    </header>
    <Prose><Content /></Prose>
  </article>
</Layout>
