---
import Layout from "../../layouts/Layout.astro";
import PostList from "../../components/PostList.astro";
import { getCollection } from "astro:content";
import { publishedPosts } from "../../utils/blog";
const posts = publishedPosts(await getCollection("blog"));
---
<Layout title="Blog | Tim Tran" description="Thoughts on software engineering and more" activeItem="blog">
  <header class="page-heading">
    <p class="eyebrow">Notes from my corner</p>
    <h1>Blog</h1>
    <p>Thoughts on software engineering, projects, and learning.</p>
  </header>
  <PostList posts={posts} ariaLabel="Blog posts" />
</Layout>
