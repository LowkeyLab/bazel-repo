---
import Layout from "../../layouts/Layout.astro";
import TagBadges from "../../components/TagBadges.astro";
import { getCollection } from "astro:content";
import { calculateReadingTime } from "../../utils/blog";
const allPosts = await getCollection("blog");
const posts = allPosts.filter((post) => !post.data.draft).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---
<Layout title="Blog | Tim Tran" description="Thoughts on software engineering and more" activeItem="blog">
  <header class="page-heading">
    <p class="eyebrow">Notes from my corner</p>
    <h1>Blog</h1>
    <p>Thoughts on software engineering, projects, and learning.</p>
  </header>
  <section class="entry-list" aria-label="Blog posts">
    {posts.length === 0 ? <p>No posts yet. Check back soon!</p> : posts.map((post) => (
      <a href={`/blog/${post.id}`} class="entry-link">
        <div class="entry-heading">
          <h2>{post.data.title}</h2>
          <time class="entry-meta" datetime={post.data.publishDate.toISOString()}>{new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric" }).format(post.data.publishDate)}</time>
        </div>
        <p class="entry-description">{post.data.description}</p>
        <p class="entry-meta mb-3">{calculateReadingTime(post.body || "")} min read</p>
        <TagBadges tags={post.data.tags} />
      </a>
    ))}
  </section>
</Layout>
