---
import Layout from "../layouts/Layout.astro";
import DevHero from "../components/DevHero.astro";
import PostList from "../components/PostList.astro";
import avatar from "../assets/avatar.jpeg";
import { getCollection } from "astro:content";
import { homePosts } from "../utils/blog";

const { featured, recent } = homePosts(await getCollection("blog"));
---

<Layout title="Tim Tran - Software Engineer" activeItem="home">
  <!-- Hero Section -->
  <DevHero
    name="Tim Tran"
    title="Software Engineer & Toil Eliminator"
    description="I build tools that help people spend less time wrestling with software and more time making things. I’m especially interested in automation, build systems, and making complicated work easier to do."
    avatarSrc={avatar}
    socials={{
      github: "https://github.com/tacascer",
      linkedin: "https://www.linkedin.com/in/timtran2018/",
      x: "https://x.com/thisIsTacascer",
      bluesky: "https://bsky.app/profile/tacascer.bsky.social",
    }}
    ctaText="Say hello"
    ctaLink="mailto:timdttran2000@gmail.com"
  />
  <section class="home-section" aria-labelledby="featured-heading">
    <h2 id="featured-heading">Things I've worked on</h2>
    <PostList posts={featured} ariaLabel="Featured writing" />
  </section>
  {recent.length > 0 && (
    <section class="home-section" aria-labelledby="recent-heading">
      <h2 id="recent-heading">Recent writing</h2>
      <PostList posts={recent} ariaLabel="Recent writing" />
      <a href="/blog/" class="ink-link all-writing">All writing <span aria-hidden="true">→</span></a>
    </section>
  )}
</Layout>
