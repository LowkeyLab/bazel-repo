---
import Layout from "./Layout.astro";
import TagBadges from "../components/TagBadges.astro";

interface Props {
  title: string;
  description: string;
  projectData: {
    title: string;
    description: string;
    tags: string[];
    startDate: Date;
    endDate?: Date;
    links: {
      github?: string;
      demo?: string;
      website?: string;
    };
  };
  activeItem?: "home" | "projects" | "contact";
}

const {
  title,
  description,
  projectData,
  activeItem = "projects",
} = Astro.props;

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    year: "numeric",
  }).format(date);
};

const dateRange = `${formatDate(projectData.startDate)} - ${
  projectData.endDate ? formatDate(projectData.endDate) : "Present"
}`;
---

<Layout title={title} description={description} activeItem={activeItem}>
  <div class="mb-8">
    <a href="/projects" class="btn btn-ghost btn-sm">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-5 h-5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
      </svg>
      Back to Projects
    </a>
  </div>

  <!-- Project Header -->
  <div class="card bg-base-100 shadow-xl mb-8">
    <div class="card-body p-6 md:p-8">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-2">
        <h1 class="text-2xl font-bold text-primary">
          {projectData.title}
        </h1>
        <div class="badge badge-md badge-outline font-semibold">{dateRange}</div>
      </div>

      <TagBadges tags={projectData.tags} size="sm" className="mb-4" />

      <p class="text-base text-base-content/80 leading-relaxed mb-6">
        {projectData.description}
      </p>

      <div class="flex gap-3">
        {
          projectData.links.github && (
            <a
              href={projectData.links.github}
              target="_blank"
              rel="noreferrer"
              class="btn btn-outline"
            >
              GitHub Repo
            </a>
          )
        }

        {
          projectData.links.demo && (
            <a
              href={projectData.links.demo}
              target="_blank"
              rel="noreferrer"
              class="btn btn-outline"
            >
              Live Demo
            </a>
          )
        }

        {
          projectData.links.website && (
            <a
              href={projectData.links.website}
              target="_blank"
              rel="noreferrer"
              class="btn btn-outline"
            >
              Website
            </a>
          )
        }
      </div>
    </div>
  </div>

  <!-- Project Content -->
  <div
    class="prose max-w-none bg-base-100 p-6 md:p-8 rounded-xl shadow-md"
  >
    <slot />
  </div>
</Layout>
