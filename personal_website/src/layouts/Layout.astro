---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
interface Props {
  title: string;
  description?: string;
  activeItem?: "home" | "contact" | "work" | "blog";
}
const {
  title,
  description = "Tim Tran - Software Engineer specializing in developer tooling and productivity",
  activeItem = "home",
} = Astro.props;
const currentYear = new Date().getFullYear();
---
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        function preferredTheme() {
          try {
            const stored = localStorage.getItem("theme");
            if (stored === "light" || stored === "dracula") return stored;
          } catch {
            // Fall back to the system preference if storage is unavailable.
          }
          return matchMedia("(prefers-color-scheme: dark)").matches ? "dracula" : "light";
        }
        document.documentElement.dataset.theme = preferredTheme();
        document.addEventListener("astro:before-swap", (event) => {
          event.newDocument.documentElement.dataset.theme = document.documentElement.dataset.theme;
        });
      })();
    </script>
    <ClientRouter />
    <style>html { scrollbar-gutter: stable; }</style>
  </head>
  <body class="site-shell">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Navbar activeItem={activeItem} />
    <main id="main-content" class="site-main site-width" tabindex="-1"><slot /></main>
    <footer class="site-footer site-width">
      <p>© {currentYear} Tim Tran</p>
      <p>Built with care, Astro, and a few pen strokes.</p>
    </footer>
  </body>
</html>
