---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
import { canonicalUrl } from "../utils/seo";
interface Props {
  title: string;
  description?: string;
  activeItem?: "home" | "about" | "blog";
  canonicalPath?: string;
  noindex?: boolean;
  article?: { title: string; description: string; publishDate: Date };
}
const {
  title,
  description = "Tim Tran - Software Engineer specializing in developer tooling and productivity",
  activeItem = "home",
  canonicalPath = Astro.url.pathname,
  noindex = false,
  article,
} = Astro.props;
if (!Astro.site) throw new Error("The production site origin must be configured");
const canonical = canonicalUrl(canonicalPath, Astro.site);
const publishedArticle = noindex ? undefined : article;
const structuredData = publishedArticle
 ? JSON.stringify({
  "@context": "https://schema.org", "@type": "BlogPosting",
  headline: publishedArticle.title, description: publishedArticle.description,
  datePublished: publishedArticle.publishDate.toISOString(),
  author: { "@type": "Person", name: "Tim Tran" }, url: canonical,
 }).replaceAll("<", "\\u003c")
 : undefined;
const currentYear = new Date().getFullYear();
---
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={publishedArticle?.title ?? title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={publishedArticle ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" type="application/rss+xml" title="Tim Tran RSS" href={canonicalUrl("/rss.xml", Astro.site)} />
    {structuredData && <script type="application/ld+json" is:inline set:html={structuredData} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        function preferredTheme() {
          try {
            const stored = localStorage.getItem("theme");
            if (stored === "light" || stored === "dracula") return stored;
          } catch {
            // Fall back to the system preference if storage is unavailable.
          }
          return matchMedia("(prefers-color-scheme: dark)").matches ? "dracula" : "light";
        }
        document.documentElement.dataset.theme = preferredTheme();
        document.addEventListener("astro:before-swap", (event) => {
          event.newDocument.documentElement.dataset.theme = document.documentElement.dataset.theme;
        });
      })();
    </script>
    <ClientRouter />
    <style>html { scrollbar-gutter: stable; }</style>
  </head>
  <body class="site-shell">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Navbar activeItem={activeItem} />
    <main id="main-content" class="site-main site-width" tabindex="-1"><slot /></main>
    <footer class="site-footer site-width">
      <p>© {currentYear} Tim Tran</p>
    </footer>
  </body>
</html>
