---
import ThemeToggle from "./ThemeToggle.astro";
interface Props {
  activeItem?: "home" | "about" | "blog";
}
const { activeItem = "home" } = Astro.props;
const links = [
  { id: "blog", href: "/blog/", label: "Blog" },
  { id: "about", href: "/about/", label: "About" },
  { id: "github", href: "https://github.com/tacascer", label: "GitHub" },
];
---
<header class="site-header">
  <nav class="site-nav site-width" aria-label="Main navigation">
    <a href="/" class="site-brand">Tim's Corner</a>
    <ul class="site-links">
      {links.map((link) => (
        <li><a href={link.href} aria-current={activeItem === link.id ? "page" : undefined}>{link.label}</a></li>
      ))}
      <li><ThemeToggle /></li>
    </ul>
  </nav>
</header>
