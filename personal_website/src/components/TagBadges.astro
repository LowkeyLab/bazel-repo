---
interface Props {
  tags: string[];
  size?: "sm" | "md" | "lg";
  className?: string;
}
const { tags, size = "sm", className = "" } = Astro.props;
const sortedTags = [...tags].sort();
---
<div class={`tags ${className}`}>
  {sortedTags.map((tag) => (
    <span class:list={["paper-tag", { "paper-tag-lg": size === "lg" }]}>{tag}</span>
  ))}
</div>
