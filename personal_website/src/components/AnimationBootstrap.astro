<script is:inline>
  (() => {
    const root = document.currentScript?.parentElement;
    if (!root || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const startedAt = performance.now();
    const runId = document.animationRunId = (document.animationRunId ?? 0) + 1;
    const section = root.localName === "home-hero-animation" ? "hero"
      : root.localName === "featured-work-animation" ? "featured_work"
        : root.localName === "recent-writing-animation" ? "recent_writing" : "other";
    let settled = false;
    let observe;
    const settle = (result, phase) => {
      if (settled) return;
      settled = true;
      const event = Object.freeze({ type: "SectionAnimationSettled", section, runId, phase, elapsedMs: performance.now() - startedAt, ...result });
      try {
        if (observe) observe(event);
        // The module/listener may never load. This is the startup availability gap.
        else console.warn(event);
      } catch {
        try { console.warn("Animation diagnostic delivery failed"); } catch { /* best effort */ }
      }
    };
    root.dataset.animationPending = "";
    let expired = false;
    let claimed = false;
    let onExpire;
    const restore = () => {
      clearTimeout(watchdog);
      onExpire = undefined;
      delete root.dataset.animationPending;
      if (!claimed) expired = true;
    };
    const watchdog = setTimeout(() => {
      const cancel = onExpire;
      restore();
      cancel?.();
      settle({ outcome: "fallback", reason: "watchdog_expired" }, "bootstrap");
    }, 2000);
    root.animationBootstrap = {
      register: (cancel, observer) => {
        observe = observer;
        if (expired) return false;
        onExpire = cancel;
        return true;
      },
      claim: () => {
        if (expired) return false;
        claimed = true;
        onExpire = undefined;
        clearTimeout(watchdog);
        return true;
      },
      restore,
      settle,
    };
  })();
</script>
