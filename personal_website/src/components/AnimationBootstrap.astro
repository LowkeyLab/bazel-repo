<script is:inline>
  (() => {
    const root = document.currentScript?.parentElement;
    if (!root || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    root.dataset.animationPending = "";
    let expired = false;
    let claimed = false;
    let onExpire;
    const restore = () => {
      clearTimeout(watchdog);
      onExpire = undefined;
      delete root.dataset.animationPending;
      if (!claimed) expired = true;
    };
    const watchdog = setTimeout(() => {
      const cancel = onExpire;
      restore();
      cancel?.();
    }, 2000);
    root.animationBootstrap = {
      register: (cancel) => {
        if (expired) return false;
        onExpire = cancel;
        return true;
      },
      claim: () => {
        if (expired) return false;
        claimed = true;
        onExpire = undefined;
        clearTimeout(watchdog);
        return true;
      },
      restore,
    };
  })();
</script>
