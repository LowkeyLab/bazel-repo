---
import type { CollectionEntry } from "astro:content";
import AnimationBootstrap from "./AnimationBootstrap.astro";
import PostList from "./PostList.astro";

interface Props {
  posts: CollectionEntry<"blog">[];
  headingId?: string;
  writingDuration?: number;
}

const { posts, headingId = "featured-heading", writingDuration = 1200 } = Astro.props;
---

<featured-work-animation data-writing-duration={writingDuration}>
  <AnimationBootstrap />
  <section class="home-section" aria-labelledby={headingId}>
    <h2 id={headingId}>featured writing</h2>
    <PostList posts={posts} ariaLabel="Featured writing" headingLevel="h3" notebook />
  </section>
</featured-work-animation>

<script>
  import { mount } from "./featured-work-animation";

  if (!customElements.get("featured-work-animation")) {
    customElements.define("featured-work-animation", class extends HTMLElement {
      private dispose?: () => void;
      private pending?: number;

      connectedCallback() {
        this.pending = window.setTimeout(() => {
          this.pending = undefined;
          if (this.isConnected) this.dispose = mount(this);
        }, 0);
      }

      disconnectedCallback() {
        if (this.pending !== undefined) clearTimeout(this.pending);
        this.pending = undefined;
        this.dispose?.();
        this.dispose = undefined;
      }
    });
  }
</script>
