---
import { Image } from "astro:assets";
interface Props {
  name: string;
  title: string;
  description: string;
  avatarSrc: ImageMetadata;
  socials?: { github?: string; linkedin?: string; mastodon?: string; bluesky?: string };
  ctaText?: string;
  ctaLink?: string;
}
const { name, title, description, avatarSrc, socials, ctaText = "Say hello", ctaLink = "mailto:timdttran2000@gmail.com" } = Astro.props;
const socialLinks = [
  { label: "GitHub", href: socials?.github },
  { label: "LinkedIn", href: socials?.linkedin },
  { label: "Mastodon", href: socials?.mastodon },
  { label: "Bluesky", href: socials?.bluesky },
].filter((link) => link.href);
---
<section class="home-hero" aria-labelledby="intro-heading">
  <div>
    <p class="eyebrow">{title} &amp; tooling enthusiast</p>
    <h1 id="intro-heading">Hi, I'm <span class="ink-underline">Tim.
      <svg viewBox="0 0 230 20" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M4 12 Q90 2 225 8 M15 17 Q130 8 216 13" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg>
    </span><br />I build leverage<br />for people.</h1>
    <p class="hero-description">{description}</p>
    <div class="hero-actions">
      <a href={ctaLink} class="paper-button">{ctaText} <span aria-hidden="true">↗</span></a>
      <a href="/blog" class="ink-link">Read the blog <span aria-hidden="true">→</span></a>
    </div>
    <div class="hero-socials">
      {socialLinks.map((link) => (
        <a href={link.href} target="_blank" rel={link.label === "Mastodon" ? "me noreferrer" : "noreferrer"}>{link.label} <span aria-hidden="true">↗</span></a>
      ))}
    </div>
  </div>
  <div class="hero-art">
    <p class="hero-note">Less toil.<br />More leverage.</p>
    <svg viewBox="0 0 430 310" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <g stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 268 Q200 256 413 267" opacity=".5" />
        <path d="M89 59 Q185 53 293 62 L277 224 Q178 217 72 222 Z" fill="var(--color-base-200)" />
        <path d="M98 69 L282 72 L267 211 L84 212 Z" fill="var(--color-base-100)" />
        <path d="M73 222 L277 224 L309 263 Q160 274 26 261 Z" fill="var(--color-base-200)" />
        <path d="M26 261 L28 268 Q175 281 309 270 L309 263 M92 232 L265 234 M77 242 L279 245 M139 250 L197 251 L201 260 L132 259 Z" />
        <path d="M119 232 L116 242 M145 233 L144 243 M172 233 L172 244 M199 234 L201 244 M228 234 L231 245 M251 234 L255 245" stroke-width="1.3" />
        <path d="M151 127 L133 145 L151 159 M207 130 L224 146 L206 161 M186 117 L174 169" stroke-width="3" />
        <path d="M343 226 L392 224 L383 268 Q369 272 352 267 Z" fill="var(--color-accent)" />
        <path d="M367 226 Q365 170 380 121 M367 207 Q346 184 337 159 M371 179 Q400 168 401 146" />
        <path d="M380 159 Q364 135 387 110 Q401 138 380 159 Z M357 193 Q333 187 328 151 Q354 156 357 193 Z M380 189 Q382 159 407 146 Q408 177 380 189 Z" fill="var(--color-accent)" />
        <path d="M379 151 L386 122 M350 181 L335 160 M387 177 L401 154" stroke-width="1.2" />
        <path d="M312 52 L320 32 M327 66 L349 54 M65 65 L51 52 M182 37 L183 23" />
        <path d="M310 102 Q337 105 341 130 M335 123 L342 133 L347 122" stroke-width="1.6" />
      </g>
    </svg>
    <div class="portrait-note">
      <Image src={avatarSrc} alt={name} width={112} height={112} />
      <span>Always happy to talk<br />about build systems.</span>
    </div>
  </div>
</section>
