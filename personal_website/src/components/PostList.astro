---
import type { CollectionEntry } from "astro:content";
import TagBadges from "./TagBadges.astro";
import { calculateReadingTime } from "../utils/blog";

interface Props {
  posts: CollectionEntry<"blog">[];
  ariaLabel: string;
  headingLevel?: "h2" | "h3";
}

const { posts, ariaLabel, headingLevel: Heading = "h2" } = Astro.props;
---

<section class="entry-list" aria-label={ariaLabel}>
  {posts.length === 0 ? <p>No posts yet. Check back soon!</p> : posts.map((post) => (
    <a href={`/blog/${post.id}/`} class="entry-link">
      <div class="entry-heading">
        <Heading class="entry-title">{post.data.title}</Heading>
        <time class="entry-meta" datetime={post.data.publishDate.toISOString()}>{new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" }).format(post.data.publishDate)}</time>
      </div>
      <p class="entry-description">{post.data.description}</p>
      <p class="entry-meta mb-3"><span class="entry-type">{post.data.type[0].toUpperCase() + post.data.type.slice(1)}</span> · {calculateReadingTime(post.body || "")} min read</p>
      <TagBadges tags={post.data.tags} />
    </a>
  ))}
</section>
