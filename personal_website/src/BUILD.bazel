load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")

copy_to_bin(
    name = "src",
    srcs = glob([
        "**/*.astro",
    ]) + glob([
        "styles/**/*.css",
    ]) + glob([
        "assets/**",
    ]) + glob([
        "content/**",
    ] + [
        "content.config.ts",
        "env.d.ts",
    ]) + glob([
        "utils/**",
    ]),
    visibility = ["//personal_website:__pkg__"],
)
