load("@rules_java//java:defs.bzl", "java_binary")

package(default_visibility = ["//visibility:public"])

java_binary(
    name = "hello",
    args = [
        "-m",
        "lowkeylab.clojure-sample.core",
    ],
    main_class = "clojure.main",
    runtime_deps = ["//clojure_sample/src/lowkeylab/clojure_sample:core"],
)

# Prose lint covers Markdown in this package, including nested non-package directories.
filegroup(
    name = "markdown",
    srcs = glob(
        ["**/*.md"],
        exclude = [
            "**/node_modules/**",
            "**/target/**",
            ".*/**",
        ],
    ),
    tags = ["markdown"],
    visibility = ["//tools/lint:__pkg__"],
)
