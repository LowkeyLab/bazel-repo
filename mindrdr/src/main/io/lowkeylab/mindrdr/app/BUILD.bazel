load("@rules_java//java:defs.bzl", "java_binary")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library")

kt_jvm_library(
    name = "ApplicationKt",
    srcs = ["Application.kt"],
    deps = [
        "//mindrdr/src/main/io/lowkeylab/mindrdr",
    ],
)

java_binary(
    name = "Application",
    main_class = "io.lowkeylab.mindrdr.app.ApplicationKt",
    resource_strip_prefix = "mindrdr/src/main/resources",
    resources = ["//mindrdr/src/main/resources"],
    runtime_deps = [
        ":ApplicationKt",
        "@maven//:ch_qos_logback_logback_classic",
    ],
)

alias(
    name = "app",
    actual = ":Application",
    visibility = ["//mindrdr:__pkg__"],
)
