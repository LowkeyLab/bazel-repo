# LLVM 0.8.21 relies on the clang executable to locate builtin headers, but
# rules_rs bindgen uses libclang and needs an explicit compile resource directory.
git_override(
    module_name = "llvm",
    commit = "9f09c2a6f92627849f9787682718fa8dcda09b79",
    patch_args = ["-p1"],
    patches = ["//3rdparty:llvm_compile_resource_directory.patch"],
    remote = "https://github.com/hermeticbuild/hermetic-llvm.git",
)

# Rust 1.96 emits LLVM raw profile version 10, but LLVM 23 expects version 11.
# Keep the coverage tools on LLVM 22 until the Rust toolchains use LLVM 23.
llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")
llvm.version(llvm_version = "22.1.8")
use_repo(llvm, "llvm-project")

