KOTLIN_VERSION = "2.2.20"

POSTGRES_VERSION = "42.7.8"

H2_VERSION = "2.3.232"

EXPOSED_VERSION = "0.61.0"

LOGBACK_VERSION = "1.4.14"

JSON_PATH_VERSION = "2.9.0"

JUNIT_VERSION = "6.0.1"

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        # Ktor dependencies (using -jvm classifier for Kotlin Multiplatform)
        "io.ktor:ktor-client-content-negotiation-jvm:%s" % KTOR_VERSION,
        "io.ktor:ktor-client-websockets-jvm:%s" % KTOR_VERSION,
        "io.ktor:ktor-serialization-kotlinx-json-jvm:%s" % KTOR_VERSION,
        "io.ktor:ktor-server-call-id-jvm:%s" % KTOR_VERSION,
        "io.ktor:ktor-server-call-logging-jvm:%s" % KTOR_VERSION,
        "io.ktor:ktor-server-config-yaml-jvm:%s" % KTOR_VERSION,
        "io.ktor:ktor-server-content-negotiation-jvm:%s" % KTOR_VERSION,
        "io.ktor:ktor-server-core-jvm:%s" % KTOR_VERSION,
        "io.ktor:ktor-server-di-jvm:%s" % KTOR_VERSION,
        "io.ktor:ktor-server-host-common-jvm:%s" % KTOR_VERSION,
        "io.ktor:ktor-server-netty-jvm:%s" % KTOR_VERSION,
        "io.ktor:ktor-server-sessions-jvm:%s" % KTOR_VERSION,
        "io.ktor:ktor-server-status-pages-jvm:%s" % KTOR_VERSION,
        "io.ktor:ktor-server-thymeleaf-jvm:%s" % KTOR_VERSION,
        "io.ktor:ktor-server-websockets-jvm:%s" % KTOR_VERSION,
        "io.ktor:ktor-server-cors-jvm:%s" % KTOR_VERSION,
        "io.ktor:ktor-server-call-id-jvm:%s" % KTOR_VERSION,
        "io.ktor:ktor-server-call-logging-jvm:%s" % KTOR_VERSION,
        # Database dependencies
        "com.h2database:h2:%s" % H2_VERSION,
        "org.jetbrains.exposed:exposed-core:%s" % EXPOSED_VERSION,
        "org.jetbrains.exposed:exposed-dao:%s" % EXPOSED_VERSION,
        "org.jetbrains.exposed:exposed-jdbc:%s" % EXPOSED_VERSION,
        "org.postgresql:postgresql:%s" % POSTGRES_VERSION,
        # Logging
        "ch.qos.logback:logback-classic:%s" % LOGBACK_VERSION,
        # JSON Path
        "com.jayway.jsonpath:json-path:%s" % JSON_PATH_VERSION,
    ],
    fetch_javadoc = True,
    fetch_sources = True,
    known_contributing_modules = [
        "bazel-repo",
        "bazel_worker_java",
        "protobuf",
    ],
    lock_file = "//:maven_install.json",
)
