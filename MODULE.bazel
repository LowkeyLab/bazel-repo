        "io.ktor:ktor-server-netty-jvm:3.3.3",
        "io.ktor:ktor-server-sessions-jvm:3.3.3",
        "io.ktor:ktor-server-status-pages-jvm:3.3.3",
        "io.ktor:ktor-server-thymeleaf-jvm:3.3.3",
        "io.ktor:ktor-server-websockets-jvm:3.3.3",
        "io.ktor:ktor-server-cors-jvm:3.3.3",
        # Database dependencies
        "com.h2database:h2:2.4.240",
        "org.jetbrains.exposed:exposed-core:0.61.0",
        "org.jetbrains.exposed:exposed-dao:0.61.0",
        "org.jetbrains.exposed:exposed-jdbc:0.61.0",
