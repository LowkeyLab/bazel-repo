# Rust
toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = "2024",
    version = "1.92.0",
)
toolchains.toolchain(
    name = "nightly_rust_toolchains",
    edition = "2024",
    version = "nightly/2026-01-11",
)
use_repo(
    toolchains,
    "default_rust_toolchains",
    "nightly_rust_toolchains",
    "rustfmt_linux_x86_64_1_92_0",
)

register_toolchains(
    "@default_rust_toolchains//:all",
    "@nightly_rust_toolchains//:all",
)

http_archive(
    name = "swagger_ui",
    build_file = "//3rdparty/swagger_ui:BUILD.swagger_ui",
    integrity = "sha256-SBJE0IEgl7Efuu73n3HZQrFxYX+cn5UU5jrL4T5xzNw=",
    patch_args = [
        "-p1",
    ],
    patches = ["//3rdparty/swagger_ui:fix.patch"],
    strip_prefix = "swagger-ui-5.17.14",
    urls = ["https://github.com/swagger-api/swagger-ui/archive/refs/tags/v5.17.14.zip"],
)

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")

inject_repo(crate, "swagger_ui")

crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "wasm32-unknown-unknown",
        "x86_64-unknown-linux-gnu",
    ],
)
crate.annotation(
    additive_build_file_content = """
filegroup(
    name = "dist",
    srcs = ["@swagger_ui//:dist"],
)
""",
    compile_data = [":dist"],
    crate = "utoipa-swagger-ui",
    gen_build_script = "off",
    patch_args = [
        "-p1",
    ],
    patches = ["//3rdparty/utoipa_swagger_ui:fix.patch"],
    rustc_env = {
        # Set this to make sure that RustEmbed points to the parent dir of the swagger ui dist
        "CARGO_MANIFEST_DIR": "$(execpath :dist)/..",
    },
)
use_repo(crate, "crates")

