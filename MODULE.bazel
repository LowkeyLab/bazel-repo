# We have to take a dependency on rules_python in order to set bootstrap=script
# for transitive dependencies, even if there are no Python rules used in this repo.
# See .bazelrc
bazel_dep(name = "rules_python", version = "2.0.3")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "gazelle", version = "0.51.3")

bazel_dep(name = "bazel_skylib_gazelle_plugin", version = "1.9.0", dev_dependency = True)
bazel_dep(name = "gazelle_rust", dev_dependency = True)
git_override(
    module_name = "gazelle_rust",
    commit = "c26dc35e8aa2a4ad08fe87ed098285c83ca71b98",
    patch_args = ["-p1"],
    patches = ["//3rdparty/gazelle_rust:rules_rs_loads.patch"],
    remote = "https://github.com/Calsign/gazelle_rust.git",
)

# Use at HEAD version of rules_angular until 0.2.0 is released
bazel_dep(name = "rules_angular")
git_override(
    module_name = "rules_angular",
    commit = "d6449197f843be14e8ab3357f3efc0ac66c8f3b0",
    patch_args = ["-p1"],
    patches = ["//3rdparty/rules_angular:fix.patch"],
    remote = "https://github.com/devversion/rules_angular.git",
)

rules_angular_ext = use_extension("@rules_angular//setup:extensions.bzl", "rules_angular")
rules_angular_ext.setup(
    angular_compiler_cli = "//:node_modules/@angular/compiler-cli",
    typescript = "//:node_modules/typescript",
)
use_repo(rules_angular_ext, "rules_angular_configurable_deps")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

# rules_lint 2.6.0 moved Rust lint support to a nested module, but the release
# archive excludes nested modules and the nested module is not published to BCR.
# Clone the release tag and copy the nested module files to this repo root so
# its absolute labels resolve as intended.
git_repository(
    name = "aspect_rules_lint_rules_rust",
    commit = "4779a112ccaabaa6b4aafdf8d9f93f21996a108e",
    patch_cmds = ["cp -R lint/rules_rust/. ."],
    remote = "https://github.com/aspect-build/rules_lint.git",
)

http_jar = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_jar")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_archive(
    name = "net_sourceforge_pmd",
    build_file_content = "\n".join([
        """load("@rules_java//java:java_import.bzl", "java_import")""",
        """java_import(name = "net_sourceforge_pmd", jars = glob(["*.jar"]), visibility = ["//visibility:public"])""",
    ]),
    integrity = "sha256-vov2j2wdZphL2WRak+Yxt4ocL0L18PhxkIL+rWdVOUA=",
    strip_prefix = "pmd-bin-7.7.0/lib",
    url = "https://github.com/pmd/pmd/releases/download/pmd_releases/7.7.0/pmd-dist-7.7.0-bin.zip",
)

http_jar(
    name = "com_puppycrawl_tools_checkstyle",
    sha256 = "51c34d738520c1389d71998a9ab0e6dabe0d7cf262149f3e01a7294496062e42",
    url = "https://github.com/checkstyle/checkstyle/releases/download/checkstyle-10.17.0/checkstyle-10.17.0-all.jar",
)

http_jar(
    name = "google-java-format",
    sha256 = "33068bbbdce1099982ec1171f5e202898eb35f2919cf486141e439fc6e3a4203",
    url = "https://github.com/google/google-java-format/releases/download/v1.17.0/google-java-format-1.17.0-all-deps.jar",
)

http_file(
    name = "pinterest_ktlint",
    executable = True,
    sha256 = "a3fd620207d5c40da6ca789b95e7f823c54e854b7fade7f613e91096a3706d75",
    url = "https://github.com/pinterest/ktlint/releases/download/1.8.0/ktlint",
)

http_jar(
    name = "facebook_ktfmt",
    sha256 = "a493271c137074436a133d72e9e323f91604c97e0c40555629ec39598efead54",
    url = "https://github.com/facebook/ktfmt/releases/download/v0.59/ktfmt-0.59-with-dependencies.jar",
)

