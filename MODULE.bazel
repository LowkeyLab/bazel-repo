#########################
# Rust
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = [
        "1.92.0",
        "nightly/2026-01-11",
    ],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

http_archive(
    name = "swagger_ui",
    build_file = "//3rdparty/swagger_ui:BUILD.swagger_ui",
    integrity = "sha256-SBJE0IEgl7Efuu73n3HZQrFxYX+cn5UU5jrL4T5xzNw=",
    patch_args = [
        "-p1",
    ],
    patches = ["//3rdparty/swagger_ui:fix.patch"],
    strip_prefix = "swagger-ui-5.17.14",
    urls = ["https://github.com/swagger-api/swagger-ui/archive/refs/tags/v5.17.14.zip"],
)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

inject_repo(crate, "swagger_ui")

crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
crate.annotation(
    additive_build_file_content = """
filegroup(
    name = "dist",
    srcs = ["@swagger_ui//:dist"],
)
""",
    compile_data = [":dist"],
    crate = "utoipa-swagger-ui",
    gen_build_script = "off",
    patch_args = [
        "-p1",
    ],
    patches = ["//3rdparty/utoipa_swagger_ui:fix.patch"],
    rustc_env = {
        # Set this to make sure that RustEmbed points to the parent dir of the swagger ui dist
        "CARGO_MANIFEST_DIR": "$(execpath :dist)/..",
    },
)
use_repo(crate, "crates")

#########################
# Go
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")

# Download an SDK for the host OS & architecture as well as common remote execution
# platforms, using the version given from the `go.mod` file.
go_sdk.from_file(go_mod = "//:go.mod")
go_sdk.nogo(nogo = "//tools/lint:nogo")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# All *direct* Go dependencies of the module have to be listed explicitly.
# Run 'bazel mod tidy' to update this
use_repo(go_deps, "com_github_gin_contrib_cors", "com_github_gin_contrib_slog", "com_github_gin_gonic_gin", "com_github_go_delve_delve", "com_github_golang_jwt_jwt_v5", "com_github_golang_migrate_migrate_v4", "com_github_google_uuid", "com_github_hay_kot_scaffold", "com_github_jackc_pgx_v5", "com_github_stretchr_testify", "com_github_testcontainers_testcontainers_go", "com_github_testcontainers_testcontainers_go_modules_postgres", "io_nmyk_cowsay", "org_golang_x_crypto", "org_golang_x_vuln")

