    module_name = "aspect_rules_lint",
    commit = "c602583358226de5cad887a3e1887c0c02c9500c",
    remote = "https://github.com/aspect-build/rules_lint.git",
)

# Vale and its Google style package are checksum-pinned by rules_lint.
lint_tools = use_extension("@aspect_rules_lint//lint:extensions.bzl", "tools")
lint_tools.vale(tag = "v3.7.0")
lint_tools.vale_styles(styles = ["Google"])
use_repo(
    lint_tools,
    "vale_Google",
    "vale_Linux_64-bit",
    "vale_Linux_arm64",
    "vale_Windows_64-bit",
    "vale_macOS_64-bit",
    "vale_macOS_arm64",
)

