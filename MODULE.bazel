module(
    name = "bazel-repo",
    version = "0.1.0",
)

# Bazel rules and support modules are pinned to upstream HEAD commits.
# Keep immutable commits so builds remain reproducible.
# Keep bazel-lib releases for their prebuilt helpers: source-built Go helpers
# create a bootstrap cycle with the LLVM toolchain.
bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
