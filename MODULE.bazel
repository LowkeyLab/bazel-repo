"Module file for building projects in lowkeylab"

module(
    name = "bazel-repo",
    version = "0.1.0",
    compatibility_level = 1,
)

bazel_dep(name = "aspect_bazel_lib", version = "2.21.2")
bazel_dep(name = "aspect_rules_esbuild", version = "0.23.0")
bazel_dep(name = "aspect_rules_js", version = "2.6.2")
bazel_dep(name = "aspect_rules_swc", version = "2.5.0")
bazel_dep(name = "aspect_rules_ts", version = "3.7.0")
bazel_dep(name = "bazel_env.bzl", version = "0.1.0", dev_dependency = True)
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "bazelrc-preset.bzl", version = "1.4.0")
bazel_dep(name = "buildifier_prebuilt", version = "8.2.0.2")
bazel_dep(name = "rules_java", version = "8.16.1")
bazel_dep(name = "rules_multitool", version = "1.9.0")
bazel_dep(name = "rules_nodejs", version = "6.5.2")
bazel_dep(name = "rules_oci", version = "2.2.6")
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "rules_rust", version = "0.66.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

#########################
# JavaScript and TypeScript
# https://github.com/aspect-build/rules_js/tree/main/e2e/bzlmod
# https://github.com/aspect-build/rules_ts/tree/main/e2e/bzlmod

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node", dev_dependency = True)
node.toolchain(
    include_headers = True,
    node_version = "20.18.0",
)
use_repo(node, "nodejs_toolchains")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")

# Allows developers to get a local node_modules tree, using
# bazel run -- @pnpm//:pnpm --dir $PWD install
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    lifecycle_hooks_execution_requirements = {
        "lmdb": ["no-remote-exec"],  # requires non-hermetic GLIBCXX_3.4.29 which is not found on remote executors but is available on host
    },
    npmrc = "//:.npmrc",
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

rules_ts_ext = use_extension(
    "@aspect_rules_ts//ts:extensions.bzl",
    "ext",
    dev_dependency = True,
)
rules_ts_ext.deps()
use_repo(rules_ts_ext, "npm_typescript")

#########################
# Fetch tools
# https://blog.aspect.build/run-tools-installed-by-bazel
multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//tools:tools.lock.json")
use_repo(multitool, "multitool")

# --- Rust Configuration ---

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "swagger_ui",
    urls = ["https://github.com/swagger-api/swagger-ui/archive/refs/tags/v5.17.14.zip"],
    integrity = "sha256-SBJE0IEgl7Efuu73n3HZQrFxYX+cn5UU5jrL4T5xzNw=",
    strip_prefix = "swagger-ui-5.17.14",
    build_file = "//3rdparty/swagger_ui:BUILD.swagger_ui",
    patches = ["//3rdparty/swagger_ui:fix.patch"],
    patch_args = [
        "-p1",
    ],
)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
inject_repo(crate, "swagger_ui")

# Regular dependencies
crate.spec(
    package = "anyhow",
    version = "1.0.100",
)
crate.spec(
    package = "askama",
    version = "0.14.0",
)
crate.spec(
    package = "axum",
    version = "0.8.6",
)
crate.spec(
    features = ["cookie"],
    package = "axum-extra",
    version = "0.10.3",
)
crate.spec(
    package = "chrono",
    version = "0.4.42",
)
crate.spec(
    package = "config",
    version = "0.15.18",
)
crate.spec(
    features = ["aws_lc_rs"],
    package = "jsonwebtoken",
    version = "10.0.0",
)
crate.spec(
    features = [
        "sqlx-postgres",
        "runtime-tokio-rustls",
        "macros",
    ],
    package = "sea-orm",
    version = "1.1.16",
)
crate.spec(
    default_features = False,
    features = [
        "runtime-tokio-rustls",
        "sqlx-postgres",
        "cli",
    ],
    package = "sea-orm-migration",
    version = "1.1.0",
)
crate.spec(
    package = "serde",
    version = "1.0.228",
)
crate.spec(
    package = "serde_json",
    version = "1.0.145",
)
crate.spec(
    package = "serde_yaml",
    version = "0.9.34",
)
crate.spec(
    package = "thiserror",
    version = "2.0.17",
)
crate.spec(
    package = "time",
    version = "0.3.44",
)
crate.spec(
    default_features = False,
    features = [
        "macros",
        "net",
        "rt-multi-thread",
    ],
    package = "tokio",
    version = "1.47.1",
)
crate.spec(
    features = ["util"],
    package = "tower",
    version = "0.5.2",
)
crate.spec(
    features = [
        "trace",
        "cors",
        "sensitive-headers",
    ],
    package = "tower-http",
    version = "0.6.6",
)
crate.spec(
    package = "tracing",
    version = "0.1.41",
)
crate.spec(
    package = "tracing-futures",
    version = "0.2.5",
)
crate.spec(
    package = "tracing-subscriber",
    version = "0.3.20",
)
crate.spec(
    features = ["axum_extras"],
    package = "utoipa",
    version = "5.4.0",
)
crate.spec(
    package = "utoipa-swagger-ui",
    version = "9.0.2",
    features = ["axum", "debug-embed"],
)
crate.annotation(
    crate = "utoipa-swagger-ui",
    gen_build_script = "off",
    patch_args = [
        "-p1",
    ],
    patches = ["//3rdparty/utoipa_swagger_ui:fix.patch"],
    additive_build_file_content = """
filegroup(
    name = "dist",
    srcs = ["@swagger_ui//:dist"],
)
""",
    rustc_env = {
        # Set this to make sure that RustEmbed points to the parent dir of the swagger ui dist
        "CARGO_MANIFEST_DIR": "$(execpath :dist)/..",
    },
    compile_data = [":dist"],
)
crate.spec(
    features = ["v4"],
    package = "uuid",
    version = "1.18.1",
)

# Dev dependencies
crate.spec(
    features = ["yaml"],
    package = "insta",
    version = "1.43.2",
)
crate.spec(
    package = "mockall",
    version = "0.13.1",
)
crate.spec(
    package = "regex",
    version = "1.11.3",
)
crate.spec(
    features = ["postgres"],
    package = "testcontainers-modules",
    version = "0.13.0",
)

crate.from_specs()
use_repo(crate, "crates")

##########################
# Container images
oci_extension = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci_extension.pull(
    name = "distroless_cc",
    digest = "sha256:0000f9dc0290f8eaf0ecceafbc35e803649087ea7879570fbc78372df7ac649b",
    image = "gcr.io/distroless/cc-debian12",
    platforms = [
        "linux/amd64",
    ],
)
use_repo(oci_extension, "distroless_cc", "distroless_cc_linux_amd64")
