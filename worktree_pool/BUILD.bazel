load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_python//python:defs.bzl", "py_test")

# gazelle:resolve rust cloudevents @crates//:cloudevents-sdk
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//tools/cargo_publish:defs.bzl", "cargo_publish")
load(":package_metadata.bzl", "WORKTREE_POOL_VERSION")

rust_binary(
    name = "worktree_pool",
    srcs = ["main.rs"],
    crate_root = "main.rs",
    edition = "2024",
    version = WORKTREE_POOL_VERSION,  # keep: shared package version for Clap and publishing
    visibility = ["//worktree_pool/benchmark:__pkg__"],  # keep: real CLI data for private adapter tests
    deps = [":worktree_pool_lib"],
)

rust_test(
    name = "cli_test",
    size = "small",
    srcs = [
        "cli_test.rs",
        "relocation_cli_tests.rs",
    ],
    crate_root = "cli_test.rs",
    data = [
        ":worktree_pool",
        "//worktree_pool/test_support",
    ],
    edition = "2024",
    env_inherit = ["PATH"],  # keep: real Git from the repository Nix development shell
    rustc_env = {
        "POOL_BINARY": "$(rootpath :worktree_pool)",
        "CRASH_BINARY": "$(rootpath //worktree_pool/test_support)",
        "INSTA_WORKSPACE_ROOT": ".",
    },
    tags = ["local"],  # keep: machine-local Git and filesystem integration
    visibility = ["//worktree_pool/install:__pkg__"],  # keep: actual installed CLI acceptance
    deps = [
        "@crates//:googletest",
        "@crates//:insta",
        "@crates//:redb",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)

rust_library(
    name = "worktree_pool_lib",
    srcs = [
        "acquisition.rs",
        "acquisition_tests.rs",
        "acquisition_workflow.rs",
        "catalog.rs",
        "catalog_recovery_cli.rs",
        "cli.rs",
        "coordination.rs",
        "creation.rs",
        "creation_workflow.rs",
        "diagnostics.rs",
        "diagnostics_tests.rs",
        "domain.rs",
        "error.rs",
        "git.rs",
        "lib.rs",
        "management.rs",
        "paths.rs",
        "rebuild.rs",
        "rebuild_tests.rs",
        "recovery.rs",
        "recovery_inspection.rs",
        "recovery_workflow.rs",
        "release.rs",
        "release_workflow.rs",
        "relocation.rs",
        "relocation_events.rs",
        "relocation_tests.rs",
        "repository_recovery.rs",
        "resources.rs",
        "retirement.rs",
        "retirement_workflow.rs",
        "store.rs",
        "store_tests.rs",
        "workflows.rs",
    ],
    crate_name = "worktree_pool",
    crate_root = "lib.rs",
    edition = "2024",
    version = WORKTREE_POOL_VERSION,  # keep: shared package version for Clap and publishing
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:chrono",
        "@crates//:clap",
        "@crates//:cloudevents-sdk",
        "@crates//:config",
        "@crates//:redb",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:thiserror",
        "@crates//:tracing",
        "@crates//:tracing-subscriber",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "worktree_pool_lib_test",
    size = "small",
    crate = ":worktree_pool_lib",
    deps = [
        "@crates//:googletest",
        "@crates//:proptest",
        "@crates//:redb",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:uuid",
    ],
)

# Prose lint covers user, contributor, and public wire documentation.
filegroup(
    name = "markdown",
    srcs = [
        "CONTRIBUTING.md",
        "DEPENDENCIES.md",
        "README.md",
        "WIRE_SCHEMA.md",
    ],
    tags = ["markdown"],
)

py_test(
    name = "publishing_test",
    size = "small",
    srcs = ["publishing_test.py"],
    data = [
        "CONTRIBUTING.md",
        "DEPENDENCIES.md",
        "LICENSE",
        "README.md",
        "WIRE_SCHEMA.md",
        ":forbidden_compilation_dependencies",
        ":publish_files",
        ":worktree_pool",
        "//:Cargo.lock",
    ],
)

cargo_publish(
    name = "publish",
    package_name = "worktree-pool",
    binaries = {":worktree_pool": "worktree-pool"},
    description = "Explicit ownership for persistent local Git worktrees",
    library = ":worktree_pool_lib",
    license = "AGPL-3.0-only",
    package_files = {
        "CONTRIBUTING.md": "CONTRIBUTING.md",
        "DEPENDENCIES.md": "DEPENDENCIES.md",
        "LICENSE": "LICENSE",
        "README.md": "README.md",
        "WIRE_SCHEMA.md": "WIRE_SCHEMA.md",
    },
    readme = "README.md",
    repository = "https://github.com/LowkeyLab/bazel-repo",
    rust_version = "1.96",
    tests = [
        ":cli_test",
        ":worktree_pool_lib_test",
    ],
    version = WORKTREE_POOL_VERSION,
)

# Public query protects ordinary compilation/test graphs from publishing inputs.
genquery(
    name = "forbidden_compilation_dependencies",
    expression = "filter('(^//tools/cargo_publish[/:]|^//worktree_pool/install[/:]|^//worktree_pool:publish([_./]|$)|^//worktree_pool:Cargo[.](toml|lock)$)', deps(set(//worktree_pool:worktree_pool_lib //worktree_pool:worktree_pool //worktree_pool:worktree_pool_lib_test //worktree_pool:cli_test)))",
    scope = [
        ":worktree_pool_lib",
        ":worktree_pool",
        ":worktree_pool_lib_test",
        ":cli_test",
    ],
)

bzl_library(
    name = "package_metadata",
    srcs = ["package_metadata.bzl"],
    visibility = ["//visibility:public"],
)
