# gazelle:resolve rust cloudevents @crates//:cloudevents-sdk
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_binary(
    name = "worktree_pool",
    srcs = ["main.rs"],
    compile_data = ["Cargo.toml"],
    crate_root = "main.rs",
    edition = "2024",
    deps = [":worktree_pool_lib"],
)

rust_test(
    name = "cli_test",
    size = "small",
    srcs = ["cli_test.rs"],
    compile_data = ["Cargo.toml"],
    crate_root = "cli_test.rs",
    data = [
        ":worktree_pool",
        "//worktree_pool/test_support",
    ],
    edition = "2024",
    env_inherit = ["PATH"],  # keep: real Git from the repository Nix development shell
    rustc_env = {
        "POOL_BINARY": "$(rootpath :worktree_pool)",
        "CRASH_BINARY": "$(rootpath //worktree_pool/test_support)",
        "INSTA_WORKSPACE_ROOT": ".",
    },
    tags = ["local"],  # keep: machine-local Git and filesystem integration
    deps = [
        "@crates//:googletest",
        "@crates//:insta",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)

rust_library(
    name = "worktree_pool_lib",
    srcs = [
        "acquisition.rs",
        "acquisition_tests.rs",
        "acquisition_workflow.rs",
        "catalog.rs",
        "cli.rs",
        "coordination.rs",
        "diagnostics.rs",
        "diagnostics_tests.rs",
        "domain.rs",
        "error.rs",
        "git.rs",
        "lib.rs",
        "management.rs",
        "paths.rs",
        "release.rs",
        "release_workflow.rs",
        "store.rs",
        "store_tests.rs",
        "workflows.rs",
    ],
    compile_data = ["Cargo.toml"],
    crate_name = "worktree_pool",
    crate_root = "lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:chrono",
        "@crates//:clap",
        "@crates//:cloudevents-sdk",
        "@crates//:config",
        "@crates//:redb",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:thiserror",
        "@crates//:tracing",
        "@crates//:tracing-subscriber",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "worktree_pool_lib_test",
    size = "small",
    crate = ":worktree_pool_lib",
    deps = [
        "@crates//:googletest",
        "@crates//:proptest",
        "@crates//:redb",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)

# Prose lint includes the public wire and test-design contracts.
filegroup(
    name = "markdown",
    srcs = ["README.md"],
    tags = ["markdown"],
)
