load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load(":verify.bzl", "verify_install")

py_binary(
    name = "driver",
    srcs = ["verify.py"],
    main = "verify.py",
    deps = ["//tools/cargo_publish:report"],
)

verify_install(
    name = "acceptance",
    testonly = True,
    cli_tests = "//worktree_pool:cli_test",
    driver = ":driver",
    git_source = "@worktree_pool_git_minimum//file",
    tags = ["manual"],
    zlib_source = "@worktree_pool_zlib//file",
)

py_test(
    name = "acceptance_test",
    size = "small",
    srcs = ["acceptance_test.py"],
    data = [":driver"],
    env = {"DRIVER": "$(rootpath :driver)"},
)

bzl_library(
    name = "verify",
    srcs = ["verify.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//worktree_pool:package_metadata"],
)
